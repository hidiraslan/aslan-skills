                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Warning: 15%" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
