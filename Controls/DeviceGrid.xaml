                                </Grid.ColumnDefinitions>

                                <!-- LEFT COLUMN: 1. Donut Chart + 4. Gauge / KPI -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                                    <!-- 1. PIE / DONUT CHART -->
                                    <GroupBox Header="1. Protocol Traffic Share (Pie / Donut Chart)" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="10,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
