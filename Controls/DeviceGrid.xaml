                                                              Data="M 2.0,53.0 A 51,51 0 0,1 11.8,23.0 L 24.3,32.1 A 35,35 0 0,0 18.0,53.0 Z">
                                                            <Path.Fill>
                                                                <RadialGradientBrush Center="53,53" GradientOrigin="53,53" RadiusX="51" RadiusY="51" MappingMode="Absolute">
                                                                    <GradientStop Color="#CBD4DE" Offset="1.0"/>
                                                                    <GradientStop Color="#9EAEBE" Offset="0.86"/>
                                                                    <GradientStop Color="#889BB0" Offset="0.78"/>
                                                                    <GradientStop Color="#657A90" Offset="0.69"/>
                                                                </RadialGradientBrush>
                                                            </Path.Fill>
