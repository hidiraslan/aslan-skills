                                                        <Path StrokeThickness="0" SnapsToDevicePixels="True"
                                                              Data="M 53.0,104.0 A 51,51 0 0,1 11.8,83.0 L 24.3,73.9 A 35,35 0 0,0 53.0,88.0 Z">
                                                            <Path.Fill>
                                                                <RadialGradientBrush Center="53,53" GradientOrigin="53,53" RadiusX="51" RadiusY="51" MappingMode="Absolute">
                                                                    <GradientStop Color="#FFE162" Offset="1.0"/>
                                                                    <GradientStop Color="#FFB812" Offset="0.86"/>
                                                                    <GradientStop Color="#F09B00" Offset="0.78"/>
                                                                    <GradientStop Color="#C97B00" Offset="0.69"/>
                                                                </RadialGradientBrush>
                                                            </Path.Fill>
                                                        </Path>
                                                        <Path StrokeThickness="0" SnapsToDevicePixels="True"
                                                              Data="M 11.8,83.0 A 51,51 0 0,1 2.0,53.0 L 18.0,53.0 A 35,35 0 0,0 24.3,73.9 Z">
                                                            <Path.Fill>
                                                                <RadialGradientBrush Center="53,53" GradientOrigin="53,53" RadiusX="51" RadiusY="51" MappingMode="Absolute">
