                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FF8484" Offset="0.0"/>
                                                                <GradientStop Color="#D61818" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Critical: 10%" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                </StackPanel>
                                                <!-- Standby (Gri) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Width="10" Height="8" CornerRadius="1" BorderBrush="#5A6D82" BorderThickness="0.8" Margin="0,0,5,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#CBD4DE" Offset="0.0"/>
                                                                <GradientStop Color="#657A90" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Standby: 10%" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                </StackPanel>
                                                <!-- Free Space -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="8" CornerRadius="1" BorderBrush="#8B9EB5" BorderThickness="0.8" Margin="0,0,5,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#DEE5EC" Offset="0.0"/>
                                                                <GradientStop Color="#EFF4F8" Offset="0.5"/>
                                                                <GradientStop Color="#F6FAFC" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="Free: 15%" FontFamily="Segoe UI" FontSize="10" Foreground="#6C839C"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 4. GAUGE / KPI METER -->
                                    <GroupBox Header="4. Hardware Capacity (Gauge / KPI Dial)" Style="{DynamicResource ClassicGroupBox}">
                                        <Grid Margin="10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="105"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Vector Semi-Circle Dial Gauge -->
                                            <Grid Grid.Row="0" Width="180" Height="105" HorizontalAlignment="Center">
                                                <Canvas Width="180" Height="105">
                                                    <!-- Background Arc (Radius 60, center at 90, 80) -->
                                                    <Path Stroke="#E2EBF4" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 30,80 A 60,60 0 0,1 150,80"/>

                                                    <!-- Active Value Arc (68.4% Load) -->
                                                    <Path Stroke="#2B7BC6" StrokeThickness="12" StrokeStartLineCap="Round"
                                                          Data="M 30,80 A 60,60 0 0,1 123,30"/>

                                                    <!-- Center Needle: radiating from exact center (90, 80) -->
                                                    <Line X1="90" Y1="80" X2="123" Y2="30" Stroke="#D9381E" StrokeThickness="2.5" StrokeEndLineCap="Round"/>

                                                    <!-- Center Pivot Pin: 12x12 centered exactly at (90, 80) -->
                                                    <Ellipse Canvas.Left="84" Canvas.Top="74" Width="12" Height="12">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.6" RadiusY="0.6">
                                                                <GradientStop Color="#FF5A45" Offset="0.0"/>
                                                                <GradientStop Color="#D9381E" Offset="0.6"/>
                                                                <GradientStop Color="#9E1B07" Offset="1.0"/>
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <!-- Center Pin Specular Glint -->
                                                    <Ellipse Canvas.Left="87.5" Canvas.Top="76.5" Width="3" Height="3" Fill="#FFFFFF" Opacity="0.85"/>

                                                    <!-- Dial Min / Max Text placed cleanly below the arc endpoints -->
                                                    <TextBlock Canvas.Left="20" Canvas.Top="90" Text="0%" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#7A8B9C"/>
                                                    <TextBlock Canvas.Left="138" Canvas.Top="90" Text="100%" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#7A8B9C"/>
                                                </Canvas>
                                            </Grid>

                                            <!-- Readout Details -->
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="68.4% " FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    <TextBlock Text="UTILIZATION" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#6C839C" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Status: Normal Operating Temperature" FontFamily="Segoe UI" FontSize="10" Foreground="#257A25" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                </StackPanel>

                                <!-- RIGHT COLUMN: 3. Line/Area Chart + 2. Bar Chart -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">

                                    <!-- 3. LINE / AREA CHART -->
                                    <GroupBox Header="3. Real-time Bandwidth Profile (Line / Area Chart)" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="12,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Chart Canvas Grid -->
                                            <Border Grid.Row="0" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1,0,0,1" Background="{DynamicResource ClassicInnerBackground}">
                                                <Grid>
                                                    <!-- Horizontal Gridlines -->
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,0,1"/>
                                                    <Border Grid.Row="1" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,0,1"/>

                                                    <!-- Translucent Area Fill underneath curve -->
                                                    <Path Grid.RowSpan="3" SnapsToDevicePixels="True" Stretch="Fill">
                                                        <Path.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#552B7BC6" Offset="0.0"/>
                                                                <GradientStop Color="#052B7BC6" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Path.Fill>
                                                        <Path.Data>
                                                            <PathGeometry Figures="M 0,0 M 0,120 L 0,85 C 60,70 120,95 180,60 C 240,25 300,75 360,35 C 420,10 480,45 536,20 L 536,120 Z"/>
                                                        </Path.Data>
                                                    </Path>

                                                    <!-- Crisp Top Vector Line -->
                                                    <Path Grid.RowSpan="3" Stroke="#1C65AB" StrokeThickness="2.2" SnapsToDevicePixels="True" Stretch="Fill">
                                                        <Path.Data>
                                                            <PathGeometry Figures="M 0,0 M 540,120 M 0,85 C 60,70 120,95 180,60 C 240,25 300,75 360,35 C 420,10 480,45 536,20"/>
                                                        </Path.Data>
                                                    </Path>

                                                    <!-- Current Live Peak Telemetry Dot: Guaranteed 100% Perfect Crisp Circle (Never distorted) -->
                                                    <Ellipse Grid.RowSpan="3"
                                                             Width="8" Height="8"
                                                             Fill="#FFFFFF"
                                                             Stroke="#1C65AB"
                                                             StrokeThickness="2"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top"
                                                             Margin="0,16,0,0"
                                                             SnapsToDevicePixels="True"
                                                             ToolTip="Live Telemetry: 78.4 Mbps (Peak Output)"/>
                                                </Grid>
                                            </Border>

                                            <!-- X-Axis Timeline Labels -->
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="00:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Grid.Column="1" Text="04:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Grid.Column="2" Text="08:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Grid.Column="3" Text="12:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Grid.Column="4" Text="16:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888"/>
                                                <TextBlock Grid.Column="5" Text="20:00" FontFamily="Segoe UI" FontSize="9" Foreground="#888888" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 2. BAR / COLUMN CHART -->
                                    <GroupBox Header="2. Daily Throughput Volume (Column / Bar Chart)" Style="{DynamicResource ClassicGroupBox}">
                                        <Grid Margin="12,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="95"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Grid Baseline & Bars -->
                                            <Border Grid.Row="0" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ClassicInnerBackground}">
                                                <Grid VerticalAlignment="Bottom" Height="90">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Mon: 45GB -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="45G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="45" Background="#4A90E2" CornerRadius="2,2,0,0" ToolTip="Monday: 45 GB"/>
                                                    </StackPanel>

                                                    <!-- Tue: 62GB -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="62G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="62" Background="#4A90E2" CornerRadius="2,2,0,0" ToolTip="Tuesday: 62 GB"/>
                                                    </StackPanel>

                                                    <!-- Wed: 80GB (Peak) -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="80G" FontFamily="Segoe UI" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="80" Background="#1D65AB" CornerRadius="2,2,0,0" ToolTip="Wednesday: 80 GB (Peak)"/>
                                                    </StackPanel>

                                                    <!-- Thu: 55GB -->
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="55G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="55" Background="#4A90E2" CornerRadius="2,2,0,0" ToolTip="Thursday: 55 GB"/>
                                                    </StackPanel>

                                                    <!-- Fri: 72GB -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="72G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="72" Background="#4A90E2" CornerRadius="2,2,0,0" ToolTip="Friday: 72 GB"/>
                                                    </StackPanel>

                                                    <!-- Sat: 30GB -->
                                                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="30G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="30" Background="#7BB0E6" CornerRadius="2,2,0,0" ToolTip="Saturday: 30 GB"/>
                                                    </StackPanel>

                                                    <!-- Sun: 25GB -->
                                                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="25G" FontFamily="Segoe UI" FontSize="8" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <Border Width="24" Height="25" Background="#7BB0E6" CornerRadius="2,2,0,0" ToolTip="Sunday: 25 GB"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Day Labels -->
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Mon" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Tue" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Wed" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="Thu" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="Fri" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="Sat" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="Sun" FontFamily="Segoe UI" FontSize="9" Foreground="#666666" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 2b. PROTOCOL THROUGHPUT DENSITY - COMPACT AERO BAR CHART -->
                                    <GroupBox Header="2b. Protocol Throughput Density (Compact Aero Bar Chart)" Style="{DynamicResource ClassicGroupBox}" Margin="0,14,0,0">
                                        <Grid Margin="12,10">
                                            <Grid.RowDefinitions>
                                                <!-- Top Subtitle and Guide Note -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Bar Chart Baseline Canvas -->
                                                <RowDefinition Height="105"/>
                                                <!-- Protocol Labels Row -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header Metric Note -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <TextBlock Text="Real-Time Protocol Bandwidth (Mbps)" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border HorizontalAlignment="Right" Background="{DynamicResource ClassicCardBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="5,1">
                                                    <TextBlock Text="Compact Bar Density (8px Gap)" FontFamily="Segoe UI" FontSize="9.5" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Bars with Baseline and Dashed Grid Lines -->
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ClassicInnerBackground}">
                                                <Grid VerticalAlignment="Bottom" Height="100">
                                                    <!-- Background Horizontal Guide Lines -->
                                                    <Grid VerticalAlignment="Stretch">
                                                        <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0"/>
                                                        <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" Margin="0,50,0,0"/>
                                                        <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" Margin="0,75,0,0"/>
                                                    </Grid>

                                                    <!-- Clustered / Compact Bars (Center Aligned, Narrow 8px Margin) -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        
                                                        <!-- 1. HTTP (Green Aero Gradient) -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="280M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#1A9308" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="58" CornerRadius="2,2,0,0" BorderBrush="#167D07" BorderThickness="1" ToolTip="HTTP Traffic: 280 Mbps">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#9AEF4E" Offset="0.0"/>
                                                                        <GradientStop Color="#40D622" Offset="0.5"/>
                                                                        <GradientStop Color="#24B812" Offset="0.8"/>
                                                                        <GradientStop Color="#1A9308" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 2. HTTPS (Royal Blue Aero Gradient) - PEAK -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="450M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" Foreground="#0D47A1" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="86" CornerRadius="2,2,0,0" BorderBrush="#0A3B7B" BorderThickness="1" ToolTip="HTTPS / SSL Traffic: 450 Mbps (Peak)">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#6ECBFD" Offset="0.0"/>
                                                                        <GradientStop Color="#269DE6" Offset="0.5"/>
                                                                        <GradientStop Color="#107EC7" Offset="0.8"/>
                                                                        <GradientStop Color="#095996" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 3. SSH / VPN (Amber Aero Gradient) -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="190M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#C97B00" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="44" CornerRadius="2,2,0,0" BorderBrush="#A36300" BorderThickness="1" ToolTip="SSH / VPN Traffic: 190 Mbps">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FFE162" Offset="0.0"/>
                                                                        <GradientStop Color="#FFB812" Offset="0.5"/>
                                                                        <GradientStop Color="#F09B00" Offset="0.8"/>
                                                                        <GradientStop Color="#C97B00" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 4. SNMP (Vermilion Red Aero Gradient) -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="95M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#A30E0E" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="26" CornerRadius="2,2,0,0" BorderBrush="#8A0C0C" BorderThickness="1" ToolTip="SNMP Telemetry: 95 Mbps">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FF8484" Offset="0.0"/>
                                                                        <GradientStop Color="#F03333" Offset="0.5"/>
                                                                        <GradientStop Color="#D61818" Offset="0.8"/>
                                                                        <GradientStop Color="#A30E0E" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 5. DNS (Violet Aero Gradient) -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="340M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#581C87" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="68" CornerRadius="2,2,0,0" BorderBrush="#4A148C" BorderThickness="1" ToolTip="DNS Query Bandwidth: 340 Mbps">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#E9D5FF" Offset="0.0"/>
                                                                        <GradientStop Color="#C084FC" Offset="0.5"/>
                                                                        <GradientStop Color="#9333EA" Offset="0.8"/>
                                                                        <GradientStop Color="#6B21A8" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 6. NTP / Sync (Cyan Aero Gradient) -->
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0">
                                                            <TextBlock Text="160M" FontFamily="Segoe UI" FontSize="8.5" FontWeight="SemiBold" Foreground="#006064" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                            <Border Width="34" Height="38" CornerRadius="2,2,0,0" BorderBrush="#004D40" BorderThickness="1" ToolTip="NTP / Clock Sync: 160 Mbps">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#E0F7FA" Offset="0.0"/>
                                                                        <GradientStop Color="#26C6DA" Offset="0.5"/>
                                                                        <GradientStop Color="#00ACC1" Offset="0.8"/>
                                                                        <GradientStop Color="#006064" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Bottom Protocol Labels -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                <TextBlock Text="HTTP" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" TextAlignment="Center"/>
                                                <TextBlock Text="HTTPS" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" Foreground="#0D47A1" TextAlignment="Center"/>
                                                <TextBlock Text="SSH/VPN" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" TextAlignment="Center"/>
                                                <TextBlock Text="SNMP" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" TextAlignment="Center"/>
                                                <TextBlock Text="DNS" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" TextAlignment="Center"/>
                                                <TextBlock Text="NTP" Width="42" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                </StackPanel>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- SECTION 3: PERFORMANCE & EXECUTION VISUALIZATIONS        -->
                            <!-- (Elements 6, 9, 10, 11: Progress/Target, Ranking, Heatmap, Timeline) -->
                            <!-- ========================================================= -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <!-- Column 1: Progress/Hedef & Ranking/Top Products -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Column 2: Heatmap & Timeline -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: 6. Progress / Bullet Chart + 9. Ranking -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                                    <!-- 6. PROGRESS / BULLET CHART -->
                                    <GroupBox Header="6. Target vs. Actual Delivery (Aero Bullet Chart)" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
