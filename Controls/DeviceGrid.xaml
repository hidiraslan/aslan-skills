                                                <!-- Warning (Amber) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Width="10" Height="8" CornerRadius="1" BorderBrush="#A37100" BorderThickness="0.8" Margin="0,0,5,0">
