                                                <TextBlock Text="Run / Start / Execute" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconRun" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="Execute &amp; debug runtime action" FontFamily="Segoe UI" FontSize="10" Foreground="#16A34A"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 54. Stop / Terminate -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconStop}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Stop / Terminate" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconStop" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="3D Yakut durdur karesi" FontFamily="Segoe UI" FontSize="10" Foreground="#DC2626"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 55. Breakpoint -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconBreakpoint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Breakpoint (Kesme)" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconBreakpoint" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="Breakpoint &amp; stop execution" FontFamily="Segoe UI" FontSize="10" Foreground="#B91C1C"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 56. Function / Lambda -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconFunction}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Function / Method" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconFunction" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="Aero Mor/Indigo f(x) simgesi" FontFamily="Segoe UI" FontSize="10" Foreground="#9333EA"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </WrapPanel>
                            </GroupBox>

                            <!-- ========================================================================= -->
                            <!-- GROUP 6: USER, AUTH & SESSION (3 ICONS)              -->
                            <!-- ========================================================================= -->
                            <GroupBox Header="6. User, Authentication &amp; Session Exit Icons" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,16">
                                <WrapPanel Margin="8,10">

                                    <!-- 57. User / Profile -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconUser}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="User / Account Profile" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconUser" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="User profile &amp; account avatar" FontFamily="Segoe UI" FontSize="10" Foreground="#1565C0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 58. Login / Sign In -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconLogin}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Login / Sign In" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconLogin" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="Authentication &amp; sign-in" FontFamily="Segoe UI" FontSize="10" Foreground="#16A34A"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 59. Exit / Sign Out -->
                                    <Border Width="220" Height="78" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="3" Margin="5" Padding="8,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" CornerRadius="3" Width="38" Height="38" VerticalAlignment="Center">
                                                <Rectangle Width="26" Height="26" Fill="{DynamicResource IconExit}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Exit / Sign Out" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <Border Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,3,0,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="IconExit" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                                                </Border>
                                                <TextBlock Text="Sign out &amp; session termination" FontFamily="Segoe UI" FontSize="10" Foreground="#DC2626"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </WrapPanel>
                            </GroupBox>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
