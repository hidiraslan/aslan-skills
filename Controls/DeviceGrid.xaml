                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 1b. PROTOCOL TRAFFIC SHARE - AERO PROGRESS BAR GRADIENT STYLE -->
                                    <GroupBox Header="1b. Protocol Traffic Share (Seamless Aero Donut)" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="10,10">
                                            <Grid.ColumnDefinitions>
                                                <!-- Seamless Donut Host -->
