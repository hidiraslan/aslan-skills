<UserControl x:Class="ClassicAeroStudio.Controls.DeviceGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:ClassicAeroStudio.Models"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Background="{DynamicResource ClassicCanvasBackground}">
        <Grid.RowDefinitions>
            <!-- Tabs: Device List, Alarms(3), Workspace / Topology -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area with border -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Strip -->
        <TabControl x:Name="ViewTabStrip"
                    Grid.Row="0"
                    Style="{DynamicResource ClassicTabStripControl}"
                    Margin="8,8,8,0"
                    SelectionChanged="OnViewTabStripSelectionChanged">
            <TabItem Header="Workspace / Topology" Style="{DynamicResource ClassicEnterpriseTabItem}" IsSelected="True"/>
            <TabItem Header="Analytics &amp; Charts" Style="{DynamicResource ClassicEnterpriseTabItem}"/>
            <TabItem Header="Icons Gallery" Style="{DynamicResource ClassicEnterpriseTabItem}"/>
            <TabItem Header="Device List (DataGrid)" Style="{DynamicResource ClassicEnterpriseTabItem}"/>
            <TabItem x:Name="AlarmsTabItem" Header="Alarms (3)" Style="{DynamicResource ClassicEnterpriseTabItem}"/>
        </TabControl>

        <!-- Content Area Border -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ClassicBorderBrush}"
                BorderThickness="1,1,1,1"
                Background="{DynamicResource ClassicCardBackground}"
                Margin="8,-1,8,8"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Grid>
                <!-- ============================================================= -->
                <!-- 1. DEVICE LIST VIEW                                           -->
                <!-- ============================================================= -->
                <Grid x:Name="DeviceListPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Sub-header bar: "Device List", Refresh, Search -->
                        <RowDefinition Height="34"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-header Bar (Responsive with Bottom Dividing Border) -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource ClassicDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource ClassicSubHeaderBackground}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      BorderThickness="0">
                            <Grid Margin="10,0,10,0" VerticalAlignment="Center" MinWidth="750">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Section Title & Subtitle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Device List &amp; Discovery"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ClassicTextTitle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="— Enterprise Network Nodes, Port Mapping &amp; Configuration"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{DynamicResource ClassicTextSubtitle}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right Controls: Refresh Button & Search Box -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Refresh Button -->
                                    <Button Style="{DynamicResource ClassicSmallToolButton}"
                                            Margin="0,0,12,0"
                                            Padding="8,1"
                                            Click="OnDeviceRefreshClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="13" Height="13"
                                                       Fill="{DynamicResource IconRefresh}"
                                                       Margin="0,0,4,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Search Box -->
                                    <TextBox Style="{DynamicResource ClassicSearchBox}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Main DataGrid with Classic Right-Click Context Menu -->
                    <DataGrid x:Name="MainDataGrid"
                              Grid.Row="1"
                              Style="{DynamicResource ClassicDataGrid}"
                              BorderThickness="0"
                              ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding SelectedDevice, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              PreviewMouseRightButtonDown="MainDataGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                <!-- 1. Configure Device -->
                                <MenuItem Header="Configure Device..."
                                          FontWeight="SemiBold"
                                          Click="OnConfigureDeviceClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconDeviceSettings}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 2. Web Management -->
                                <MenuItem Header="Open Web Management (HTTP)...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconPort}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 3. Ping Device -->
                                <MenuItem Header="Ping Device (ICMP)..."
                                          Click="OnPingDeviceClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconSearch}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 4. Change Password -->
                                <MenuItem Header="Change Password...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconChangePassword}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 5. Time Settings -->
                                <MenuItem Header="Time Settings..."
                                          Click="OnTimeSettingsClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconTimeSettings}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 6. SNMP -->
                                <MenuItem Header="SNMP Community &amp; Traps...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconSNMP}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 7. Backup / Restore -->
                                <MenuItem Header="Backup Configuration File...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconBackupRestore}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="Firmware Upgrade...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconFirmwareUpgrade}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 8. Reboot & Reset -->
                                <MenuItem Header="Reboot Device..."
                                          Click="OnRebootDeviceClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconReboot}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="Reset to Factory Defaults...">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconReset}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 9. Clipboard Operations -->
                                <MenuItem Header="Copy MAC Address"
                                          InputGestureText="Ctrl+C"
                                          Click="OnCopyMacClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconGeneral}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <MenuItem Header="Copy IPv4 Address"
                                          Click="OnCopyIpClicked"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- 1. CheckBox Column -->
                            <DataGridTemplateColumn Width="28" CanUserResize="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ClassicDataGridCell}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource ClassicCheckBox}"
                                                  ToolTip="Select / Deselect All Devices"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="OnSelectAllHeaderClicked"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource ClassicCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. Status Column with Multi-Color Glossy LED Indicators -->
                            <DataGridTemplateColumn Header="Status" Width="50" CanUserResize="True">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ClassicDataGridCell}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                                            <Rectangle x:Name="StatusLed"
                                                       Width="12" Height="12"
                                                       Margin="0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{DynamicResource IconStatusOnline}"
                                                       ToolTip="{Binding StatusTooltip}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="Warning">
                                                <Setter TargetName="StatusLed" Property="Fill" Value="{DynamicResource IconStatusWarning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="Critical">
                                                <Setter TargetName="StatusLed" Property="Fill" Value="{DynamicResource IconStatusCritical}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="Maintenance">
                                                <Setter TargetName="StatusLed" Property="Fill" Value="{DynamicResource IconStatusMaintenance}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="Inactive">
                                                <Setter TargetName="StatusLed" Property="Fill" Value="{DynamicResource IconStatusInactive}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="Disabled">
                                                <Setter TargetName="StatusLed" Property="Fill" Value="{DynamicResource IconStatusDisabled}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Actions Column: In-Row Classic Aero Action Buttons -->
                            <DataGridTemplateColumn Width="105" CanUserResize="True"
                                                    CellStyle="{DynamicResource ClassicDataGridCellCentered}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Actions" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Config / Manage Button with Icon + Label -->
                                            <Button Style="{DynamicResource ClassicSmallToolButton}"
                                                    Height="18"
                                                    Padding="5,0"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Configure and manage this device"
                                                    Click="OnConfigureDeviceClicked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="10" Height="10"
                                                               Fill="{DynamicResource IconDeviceSettings}"
                                                               Margin="0,0,3,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Config"
                                                               FontFamily="Segoe UI"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Ping Tool Button (Compact Icon Button) -->
                                            <Button Style="{DynamicResource ClassicSmallToolButton}"
                                                    Height="18"
                                                    Width="20"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Ping Device (ICMP Echo)"
                                                    Click="OnPingDeviceClicked">
                                                <Rectangle Width="10" Height="10"
                                                           Fill="{DynamicResource IconSearch}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. Inline Health CheckBox Column -->
                            <DataGridTemplateColumn Width="55" CanUserResize="True"
                                                    CellStyle="{DynamicResource ClassicDataGridCellCentered}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Monitor" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource ClassicCheckBox}"
                                                  IsChecked="True"
                                                  ToolTip="Enable real-time background SNMP telemetry"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 5. Model Name -->
                            <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="105"/>

                            <!-- 4. Product Type -->
                            <DataGridTextColumn Header="Product Type" Binding="{Binding ProductType}" Width="85"/>

                            <!-- 5. Device Name -->
                            <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="100"/>

                            <!-- 6. MAC -->
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="115"/>

                            <!-- 7. IPv4 -->
                            <DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="95"/>

                            <!-- 8. IPv6 -->
                            <DataGridTextColumn Header="IPv6" Binding="{Binding IPv6}" Width="65"/>

                            <!-- 9. Device Time -->
                            <DataGridTextColumn Header="Device Time" Binding="{Binding DeviceTime}" Width="105"/>

                            <!-- 10. Interface -->
                            <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="70"/>

                            <!-- 11. FW Version -->
                            <DataGridTextColumn Header="FW Version" Binding="{Binding FwVersion}" Width="80"/>

                            <!-- 12. HW Version -->
                            <DataGridTextColumn Header="HW Version" Binding="{Binding HwVersion}" Width="80"/>

                            <!-- 13. Serial Number -->
                            <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="100"/>

                            <!-- 14. IP Mode -->
                            <DataGridTextColumn Header="IP Mode" Binding="{Binding IpMode}" Width="75"/>

                            <!-- 15. Protocol Version -->
                            <DataGridTextColumn Header="Protocol Version" Binding="{Binding ProtocolVersion}" Width="95"/>

                            <!-- 16. DDP Information -->
                            <DataGridTextColumn Header="DDP Information" Binding="{Binding DdpInformation}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>


                <!-- ============================================================= -->
                <!-- 2. ALARMS & EVENTS VIEW (With Responsive Clearance Fix)       -->
                <!-- ============================================================= -->
                <Grid x:Name="AlarmsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Sub-header bar: Title, Badge Chips, Filter, Actions -->
                        <RowDefinition Height="34"/>
                        <!-- Alarms DataGrid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-header Bar (Responsive with Bottom Dividing Border) -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource ClassicDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource ClassicSubHeaderBackground}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      BorderThickness="0">
                            <Grid Margin="10,0,10,0" VerticalAlignment="Center" MinWidth="850">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title, Subtitle and Summary Badges -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="System Alarms &amp; Events"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ClassicTextTitle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="— Active Faults, Alerts &amp; Syslog Severity Monitoring"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Foreground="{DynamicResource ClassicTextSubtitle}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>

                                <!-- Critical Badge -->
                                <Border BorderBrush="{DynamicResource ClassicBadgeCriticalBorder}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="{DynamicResource ClassicBadgeCriticalBackground}"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CriticalBadgeText"
                                               Text="● 1 Critical"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ClassicBadgeCriticalForeground}"/>
                                </Border>

                                <!-- Warning Badge -->
                                <Border BorderBrush="{DynamicResource ClassicBadgeWarningBorder}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="{DynamicResource ClassicBadgeWarningBackground}"
                                        Padding="5,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="WarningBadgeText"
                                               Text="▲ 2 Warning"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ClassicBadgeWarningForeground}"/>
                                </Border>

                                <!-- Information Badge -->
                                <Border BorderBrush="{DynamicResource ClassicBadgeInfoBorder}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Background="{DynamicResource ClassicBadgeInfoBackground}"
                                        Padding="5,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="InfoBadgeText"
                                               Text="ℹ 1 Informational"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                </Border>
                            </StackPanel>

                            <!-- Right: Actions, Filter & Search -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Filter ComboBox with Filter Icon -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Rectangle Width="13" Height="13"
                                               Fill="{DynamicResource IconFilter}"
                                               Margin="0,0,3,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AlarmsFilterCombo"
                                              Style="{DynamicResource ClassicComboBox}"
                                              Width="110"
                                              SelectedIndex="0"
                                              SelectionChanged="OnAlarmSeverityFilterChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="All Severities"/>
                                        <ComboBoxItem Content="Critical Only"/>
                                        <ComboBoxItem Content="Warning Only"/>
                                        <ComboBoxItem Content="Unacknowledged"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Acknowledge Button -->
                                <Button Style="{DynamicResource ClassicSmallToolButton}"
                                        Margin="0,0,4,0"
                                        Padding="6,1"
                                        Click="OnAcknowledgeSelectedAlarmClicked"
                                        ToolTip="Mark selected alarm(s) as acknowledged">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="13" Height="13"
                                                   Fill="{DynamicResource IconAcknowledge}"
                                                   Margin="0,0,3,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Acknowledge"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Clear Button -->
                                <Button Style="{DynamicResource ClassicSmallToolButton}"
                                        Margin="0,0,4,0"
                                        Padding="6,1"
                                        Click="OnClearResolvedAlarmsClicked"
                                        ToolTip="Remove acknowledged and resolved alarms from active view">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="13" Height="13"
                                                   Fill="{DynamicResource IconClear}"
                                                   Margin="0,0,3,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Clear"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Export Log Button -->
                                <Button Style="{DynamicResource ClassicSmallToolButton}"
                                        Margin="0,0,8,0"
                                        Padding="6,1"
                                        Click="OnExportAlarmsClicked"
                                        ToolTip="Export active alarm logs to CSV/Syslog">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="13" Height="13"
                                                   Fill="{DynamicResource IconExportLog}"
                                                   Margin="0,0,3,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Export..."
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Search Box -->
                                <TextBox Style="{DynamicResource ClassicSearchBox}"
                                         Width="110"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Alarms DataGrid -->
                    <DataGrid x:Name="AlarmsDataGrid"
                              Grid.Row="1"
                              Style="{DynamicResource ClassicDataGrid}"
                              BorderThickness="0"
                              ItemsSource="{Binding Alarms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding SelectedAlarm, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              PreviewMouseRightButtonDown="AlarmsDataGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                <MenuItem Header="Acknowledge Selected Alarm"
                                          FontWeight="SemiBold"
                                          Click="OnAcknowledgeSelectedAlarmClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconAcknowledge}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Mute Buzzer / Silence Sound"/>
                                <MenuItem Header="Filter View by this Device"/>
                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>
                                <MenuItem Header="Copy Alarm Description"
                                          InputGestureText="Ctrl+C"
                                          Click="OnCopyAlarmDescClicked"/>
                                <MenuItem Header="Export Alarm Log to CSV..."
                                          Click="OnExportAlarmsClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconExportLog}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- 1. Selection CheckBox -->
                            <DataGridTemplateColumn Width="28" CanUserResize="False"
                                                    CellStyle="{DynamicResource ClassicDataGridCellCentered}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource ClassicCheckBox}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource ClassicCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. Severity Icon -->
                            <DataGridTemplateColumn Width="38" CanUserResize="True"
                                                    CellStyle="{DynamicResource ClassicDataGridCellCentered}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Sev" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle x:Name="SevIconRect" Width="13" Height="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Fill="{DynamicResource IconAlarmWarning}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AlarmSeverity.Critical}">
                                                <Setter TargetName="SevIconRect" Property="Fill" Value="{DynamicResource IconAlarmCritical}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AlarmSeverity.Information}">
                                                <Setter TargetName="SevIconRect" Property="Fill" Value="{DynamicResource IconAlarmInfo}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. Severity Text -->
                            <DataGridTemplateColumn Header="Severity" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="SevText"
                                                   Text="{Binding SeverityText}"
                                                   FontFamily="Segoe UI"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ClassicBadgeWarningForeground}"
                                                   VerticalAlignment="Center"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AlarmSeverity.Critical}">
                                                <Setter TargetName="SevText" Property="Foreground" Value="{DynamicResource ClassicBadgeCriticalForeground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:AlarmSeverity.Information}">
                                                <Setter TargetName="SevText" Property="Foreground" Value="{DynamicResource ClassicBadgeInfoForeground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter TargetName="SevText" Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. Alarm ID -->
                            <DataGridTextColumn Header="Alarm ID" Binding="{Binding AlarmId}" Width="75"/>

                            <!-- 5. Device Name -->
                            <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="120"/>

                            <!-- 6. IP Address -->
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="95"/>

                            <!-- 7. Category -->
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115"/>

                            <!-- 8. Timestamp -->
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="125"/>

                            <!-- 9. Description -->
                            <DataGridTextColumn Header="Description / Event Message" Binding="{Binding Description}" Width="*"/>

                            <!-- 10. Status -->
                            <DataGridTemplateColumn Header="Status" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="StatusTxt"
                                                   Text="{Binding StatusText}"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ClassicBadgeWarningForeground}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="{DynamicResource ClassicBadgeSuccessForeground}"/>
                                                <Setter TargetName="StatusTxt" Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="{DynamicResource ClassicBadgeCriticalForeground}"/>
                                                <Setter TargetName="StatusTxt" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>


                <!-- ============================================================= -->
                <!-- 3. WORKSPACE / TOPOLOGY & ENTERPRISE COMPONENT SHOWCASE       -->
                <!-- ============================================================= -->
                <Grid x:Name="WorkspacePanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Sub-header bar -->
                        <RowDefinition Height="34"/>
                        <!-- Top KPI Quick-Strip -->
                        <RowDefinition Height="64"/>
                        <!-- Clean Canvas / Comprehensive UI Catalog -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sub-header Bar (Responsive with Bottom Dividing Border) -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource ClassicDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource ClassicSubHeaderBackground}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      BorderThickness="0">
                            <Grid Margin="10,0,10,0" VerticalAlignment="Center" MinWidth="850">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Section Title & Subtitle -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Workspace &amp; Topology Canvas"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ClassicTextTitle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="— Enterprise UI Components &amp; Architecture Library"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               Foreground="{DynamicResource ClassicTextSubtitle}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right: Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Add Component Button -->
                                    <Button Style="{DynamicResource ClassicSmallToolButton}"
                                            Margin="0,0,6,0"
                                            Padding="8,1"
                                            Click="OnAddWidgetClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="13" Height="13"
                                                       Fill="{DynamicResource IconWorkspace}"
                                                       Margin="0,0,4,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="+ Add Component"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Reset Layout Button -->
                                    <Button Style="{DynamicResource ClassicSmallToolButton}"
                                            Margin="0,0,12,0"
                                            Padding="8,1"
                                            Click="OnResetLayoutClicked">
                                        <TextBlock Text="Reset Layout"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Search Box -->
                                    <TextBox Style="{DynamicResource ClassicSearchBox}"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Top KPI Summary Bar (Clean Enterprise Metric Cards) -->
                    <Border Grid.Row="1"
                            BorderBrush="#D0DFEE"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource ClassicSubHeaderBackground}"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Managed Devices -->
                            <StackPanel Grid.Column="0" Margin="8,0">
                                <TextBlock Text="MANAGED DEVICES" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="4 Total (4 Online, 0 Offline)" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="#D0DFEE"/>

                            <!-- Card 2: PoE Power Consumption (Responsive DockPanel) -->
                            <DockPanel Grid.Column="2" Margin="10,0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="POE POWER UTILIZATION" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}"/>
                                <TextBlock DockPanel.Dock="Left" Text="74W (20%)" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center" Margin="0,3,6,0"/>
                                <ProgressBar Style="{DynamicResource ClassicProgressBar}" Height="11" Value="20" MinWidth="35" MaxWidth="70" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,3,0,0"/>
                            </DockPanel>

                            <Rectangle Grid.Column="3" Fill="#D0DFEE"/>

                            <!-- Card 3: Network Aggregate Traffic -->
                            <StackPanel Grid.Column="4" Margin="12,0">
                                <TextBlock Text="AGGREGATE TRAFFIC" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}"/>
                                <TextBlock Text="Rx: 42.8 Mbps  |  Tx: 18.2 Mbps" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Rectangle Grid.Column="5" Fill="#D0DFEE"/>

                            <!-- Card 4: System Health & Alarms -->
                            <StackPanel Grid.Column="6" Margin="12,0">
                                <TextBlock Text="SYSTEM HEALTH &amp; ALERTS" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Rectangle Width="11" Height="11" Fill="{DynamicResource IconAlarmWarning}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="3 Active Alerts (1 Critical)" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicBadgeCriticalForeground}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Canvas Area: Topology Diagram + Comprehensive UI Elements Gallery (touch pan enabled) -->
                    <ScrollViewer x:Name="WorkspaceScrollViewer"
                                  Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="Both"
                                  PanningRatio="1"
                                  PanningDeceleration="0.001"
                                  RequestBringIntoView="OnScrollViewerRequestBringIntoView"
                                  Background="{DynamicResource ClassicInnerBackground}">
                        <StackPanel Margin="16">

                            <!-- 1. Clean Info Banner Card -->
                            <Border BorderBrush="{DynamicResource ClassicBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource ClassicCardBackground}"
                                    CornerRadius="3"
                                    Padding="14,10"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0"
                                               Width="32" Height="32"
                                               Fill="{DynamicResource IconWorkspace}"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Modular Workspace &amp; Tool Canvas"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ClassicTextTitle}"/>
                                        <TextBlock Text="Modular workspace canvas designed for enterprise topology maps, device telemetry panels, and custom visual widgets."
                                                   FontFamily="Segoe UI"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ClassicTextSubtitle}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource ClassicSmallToolButton}"
                                                Padding="10,3"
                                                Click="OnAddWidgetClicked">
                                            <TextBlock Text="+ Add Module" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. Topology Node Blueprint Diagram (Visual Interactive Demo) -->
                            <GroupBox Header="Network Topology Overview"
                                      Style="{DynamicResource ClassicGroupBox}"
                                      Margin="0,0,0,16">
                                <Grid Margin="10,12,10,10" MinHeight="160">
                                    <Grid.ColumnDefinitions>
                                        <!-- Node 1: Core Switch -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Connector 1 -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- Node 2: Distribution PoE -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Connector 2 -->
                                        <ColumnDefinition Width="60"/>
                                        <!-- Node 3: Access Point -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Node 1: Core Switch -->
                                    <Border Grid.Column="0"
                                            BorderBrush="{DynamicResource ClassicBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ClassicCardBackground}"
                                            CornerRadius="2"
                                            Padding="10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="CORE SWITCH" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                                <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="DGS-1510-28X" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <TextBlock Text="IP: 192.168.1.2" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextBody}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Ports: 24 GbE + 4 10G SFP+" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,1,0,0"/>
                                            <Border Background="{DynamicResource ClassicBadgeInfoBackground}" BorderBrush="{DynamicResource ClassicBadgeInfoBorder}" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="0,6,0,0">
                                                <TextBlock Text="Uplink: 10 Gbps Fiber [OK]" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Connector 1 -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Line X1="0" Y1="0" X2="60" Y2="0" Stroke="#7B9CBF" StrokeThickness="2" StrokeDashArray="2,1"/>
                                        <Border Background="{DynamicResource ClassicCardBackground}" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2,1" HorizontalAlignment="Center">
                                            <TextBlock Text="Trunk" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource ClassicTextTitle}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Node 2: Distribution PoE -->
                                    <Border Grid.Column="2"
                                            BorderBrush="{DynamicResource ClassicBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ClassicCardBackground}"
                                            CornerRadius="2"
                                            Padding="10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="DISTRIBUTION POE" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                                <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="DGS-1210-28P/ME" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <TextBlock Text="IP: 192.168.1.10" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextBody}" Margin="0,2,0,0"/>
                                            <TextBlock Text="PoE Active: 6 Ports (74W)" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,1,0,0"/>
                                            <Border Background="{DynamicResource ClassicBadgeWarningBackground}" BorderBrush="{DynamicResource ClassicBadgeWarningBorder}" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="0,6,0,0">
                                                <TextBlock Text="Port 1/0/24: Link Flap Warning" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicBadgeWarningForeground}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Connector 2 -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Line X1="0" Y1="0" X2="60" Y2="0" Stroke="#7B9CBF" StrokeThickness="2"/>
                                        <Border Background="{DynamicResource ClassicCardBackground}" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2,1" HorizontalAlignment="Center">
                                            <TextBlock Text="PoE+" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource ClassicTextTitle}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Node 3: Access Point -->
                                    <Border Grid.Column="4"
                                            BorderBrush="{DynamicResource ClassicBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ClassicCardBackground}"
                                            CornerRadius="2"
                                            Padding="10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="ACCESS POINT (AP)" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                                <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="DAP-2660 (Floor 2)" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <TextBlock Text="IP: 192.168.1.55" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextBody}" Margin="0,2,0,0"/>
                                            <TextBlock Text="SSID: Enterprise-Corp-5G" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,1,0,0"/>
                                            <Border Background="{DynamicResource ClassicBadgeInfoBackground}" BorderBrush="{DynamicResource ClassicBadgeInfoBorder}" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="0,6,0,0">
                                                <TextBlock Text="Clients Connected: 24" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!-- ============================================================= -->
                            <!-- 3. INTERACTIVE MODALS & DIALOGS LAUNCH BAR                   -->
                            <!-- ============================================================= -->
                            <GroupBox Header="Modals, Dialogs &amp; External Forms Launcher"
                                      Style="{DynamicResource ClassicGroupBox}"
                                      Margin="0,0,0,16">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="Click buttons below to launch interactive dialog and modal form components in their live Aero environment:"
                                               FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,10"/>

                                    <!-- 1. Complex Form & Window Dialogs -->
                                    <TextBlock Text="WINDOW &amp; FORM DIALOGS:" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <!-- Login Dialog Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenLoginDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconKey}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Login Form Dialog..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- File Picker Dialog Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenFilePickerDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFolder}" Margin="0,0,6,0"/>
                                                <TextBlock Text="File Picker Dialog..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Interactive Modal Showcase Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenModalDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconDeviceSettings}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Component Modal / TaskDialog..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Settings Window Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenSettingsDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconGeneral}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Sidebar Settings Form..."/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Confirm Reboot Dialog Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnRebootDeviceClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconReboot}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Confirm Action Dialog..."/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 2. Simple Notification & Progress Dialogs -->
                                    <TextBlock Text="SIMPLE NOTIFICATION &amp; PROGRESS DIALOGS:" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel>
                                        <!-- Single Button Info Message Dialog -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenInfoDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconAlarmInfo}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Single-Button Info Dialog (Information / OK)"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Two Buttons Confirmation Dialog -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenQuestionDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconAlarmQuestion}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Two-Button Confirm Dialog (Yes / No)"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Warning / Critical Alert Dialog -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenWarningDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconAlarmWarning}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Warning &amp; Error Alert Dialog"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Animated ProgressBar Task Dialog -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenProgressDialogClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFirmwareUpgrade}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Aero ProgressBar Task Dialog..."/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 3. Classic Window Layout Shells -->
                                    <TextBlock Text="WINDOW LAYOUT SHELLS &amp; ARCHITECTURE TEMPLATES:" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,4,0,6"/>
                                    <WrapPanel>
                                        <!-- Windows Explorer Shell -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenExplorerLayoutClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFolder}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Windows Explorer Shell (Files &amp; Network Navigation)..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- MMC Console Shell -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenMmcLayoutClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconSettings}" Margin="0,0,6,0"/>
                                                <TextBlock Text="MMC Console Shell (Tree + Grid + Action Panel)..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Multi-Document Studio Shell -->
                                        <Button Style="{DynamicResource ClassicStandardButton}"
                                                Height="26"
                                                Padding="10,2"
                                                Margin="0,0,10,8"
                                                Click="OnOpenStudioLayoutClicked">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconCode}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Multi-Doc Studio Shell (Tabbed Code &amp; Console)..." FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- ============================================================= -->
                            <!-- 4. CLASSIC AERO BUTTON VARIETIES & COMMAND CONTROLS           -->
                            <!-- ============================================================= -->
                            <GroupBox Header="Button Varieties &amp; Command Controls (Classic Aero UI)"
                                      Style="{DynamicResource ClassicGroupBox}"
                                      Margin="0,0,0,16">
                                <StackPanel Margin="10,8">
                                    <!-- 1. Core Dialog & Action Buttons -->
                                    <TextBlock Text="1. STANDART VE VURGULU EYLEM BUTONLARI (PRIMARY / DANGER / SUCCESS):"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <!-- Standard Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}" Content="Standard (Cancel)" Margin="0,0,10,6"/>
                                        <!-- Primary Default Button -->
                                        <Button Style="{DynamicResource ClassicDefaultButton}" Content="Primary / Default (OK)" Margin="0,0,10,6"/>
                                        <!-- Success Button -->
                                        <Button Style="{DynamicResource ClassicSuccessButton}" Content="Success (Apply / Save)" Margin="0,0,10,6"/>
                                        <!-- Danger Button -->
                                        <Button Style="{DynamicResource ClassicDangerButton}" Content="Danger (Delete / Reset)" Margin="0,0,10,6"/>
                                        <!-- Disabled Button -->
                                        <Button Style="{DynamicResource ClassicStandardButton}" Content="Disabled Button" IsEnabled="False" Margin="0,0,10,6"/>
                                    </WrapPanel>

                                    <!-- 2. Buttons With Icons -->
                                    <TextBlock Text="2. ICON + LABEL ACTION BUTTONS:"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Style="{DynamicResource ClassicStandardButton}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconSave}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicStandardButton}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconRefresh}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh Grid" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicStandardButton}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconSearch}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Search / Find..." VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicSuccessButton}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconAcknowledge}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Acknowledge All" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicDangerButton}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconReset}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Factory Reset" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 3. Toolbar & Utility Buttons -->
                                    <TextBlock Text="3. COMPACT TOOLBAR BUTTONS (22PX):"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Style="{DynamicResource ClassicSmallToolButton}" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add Device" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicSmallToolButton}" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="12" Height="12" Fill="{DynamicResource IconExportLog}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicSmallToolButton}" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="12" Height="12" Fill="{DynamicResource IconFilter}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Filter Results" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicSmallToolButton}" IsEnabled="False" Content="Disabled Tool" Margin="0,0,8,6"/>
                                    </WrapPanel>

                                    <!-- 4. Square / Round Icon-Only Buttons -->
                                    <TextBlock Text="4. ICON-ONLY TOOL BUTTONS (22X22):"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Search" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconSearch}"/>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Refresh" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconRefresh}"/>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Settings" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconSettings}"/>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Terminal" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconTerminal}"/>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Code" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconCode}"/>
                                        </Button>
                                        <Button Style="{DynamicResource ClassicToolIconButton}" ToolTip="Disabled Icon" IsEnabled="False" Margin="0,0,6,0">
                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconClear}"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 5. Split Buttons & Dropdown Action Buttons -->
                                    <TextBlock Text="5. SPLIT &amp; DROPDOWN BUTTONS:"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <!-- Split Button 1: Start Diagnostics (Authentic Windows 7 Aero Split Button) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                            <!-- Action Part: Click starts default quick ping -->
                                            <Button Style="{DynamicResource ClassicSplitActionButton}"
                                                    ToolTip="Click: Run Quick Diagnostics (ICMP Ping)"
                                                    Click="OnSplitDiagnosticsActionClicked">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="12" Height="12" Fill="{DynamicResource IconRun}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Start Diagnostics" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- Dropdown Arrow Part: Click opens ContextMenu -->
                                            <Button Style="{DynamicResource ClassicSplitArrowButton}"
                                                    ToolTip="Click: Additional Diagnostic Options"
                                                    Click="OnSplitDiagnosticsArrowClicked">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                                        <MenuItem Header="⚡ Quick ICMP Ping Sweep (Default)" Click="OnDiagnosticOptionClicked" FontWeight="SemiBold">
                                                            <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconRun}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="🔍 Comprehensive TCP / UDP Port Scan..." Click="OnDiagnosticOptionClicked">
                                                            <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconSearch}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="📊 Bandwidth &amp; Packet Loss Test..." Click="OnDiagnosticOptionClicked">
                                                            <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconAcknowledge}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="📡 Continuous Telemetry Stream" Click="OnDiagnosticOptionClicked">
                                                            <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconSNMP}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Style="{DynamicResource ClassicMenuSeparator}"/>
                                                        <MenuItem Header="⚙ Diagnostic &amp; Logging Settings..." Click="OnDiagnosticOptionClicked">
                                                            <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconSettings}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>

                                        <!-- Dropdown Action Button (Single Button with arrow) -->
                                        <Button Style="{DynamicResource ClassicStandardButton}" Height="24" Padding="8,1" Margin="0,0,12,6"
                                                Click="OnDatabaseBackupButtonClicked"
                                                ToolTip="Click: Database &amp; Config Backup Menu">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="12" Height="12" Fill="{DynamicResource IconDatabase}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Database Backup" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Path Width="6" Height="4" Stretch="Fill" Fill="{DynamicResource ClassicTextTitle}" Data="M 0,0 L 6,0 L 3,3 Z" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                                    <MenuItem Header="💾 Create Full Backup (Full NVRAM &amp; DB Backup)" Click="OnBackupOptionClicked" FontWeight="SemiBold">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconSave}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="📑 Incremental Configuration Backup..." Click="OnBackupOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconFile}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="☁ Push to Remote TFTP / SFTP Server..." Click="OnBackupOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconExportLog}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{DynamicResource ClassicMenuSeparator}"/>
                                                    <MenuItem Header="🕒 Automatic Backup Schedule..." Click="OnBackupOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconTimeSettings}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="📂 Open Backup Directory (C:\Backups)" Click="OnBackupOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconFolder}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <!-- App Pill Ribbon Header Button -->
                                        <Button Style="{DynamicResource ClassicAppPillButton}" Margin="0,0,12,6" VerticalAlignment="Center"
                                                Click="OnAppPillButtonClicked"
                                                ToolTip="Click: Quick Application &amp; System Menu">
                                            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFF" Data="M 0,0 L 7,0 L 3.5,4 Z"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                                    <MenuItem Header="⚙ Genel Sistem Tercihleri..." Click="OnAppPillOptionClicked" FontWeight="SemiBold">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconSettings}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="🔄 Restart Services &amp; Refresh UI" Click="OnAppPillOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconRefresh}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{DynamicResource ClassicMenuSeparator}"/>
                                                    <MenuItem Header="ℹ Sistem ve Lisans Bilgisi..." Click="OnAppPillOptionClicked">
                                                        <MenuItem.Icon><Rectangle Width="16" Height="16" Fill="{DynamicResource IconGeneral}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 6. Ribbon Large & Toggle Buttons -->
                                    <TextBlock Text="6. RIBBON &amp; TOGGLE BUTTONS:"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <!-- Ribbon Large Normal Button -->
                                        <Button Style="{DynamicResource ClassicRibbonButton}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="24" Height="24" Fill="{DynamicResource IconDiscovery}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock Text="Discover&#x0a;Devices" FontFamily="Segoe UI" FontSize="10" TextAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Ribbon Toggle Button (Unchecked) -->
                                        <ToggleButton Style="{DynamicResource ClassicRibbonToggleButton}" IsChecked="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="24" Height="24" Fill="{DynamicResource IconSNMP}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock Text="Event&#x0a;Logs" FontFamily="Segoe UI" FontSize="10" TextAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            </StackPanel>
                                        </ToggleButton>

                                        <!-- Ribbon Toggle Button (Checked / Sunken Aero Blue Active) -->
                                        <ToggleButton Style="{DynamicResource ClassicRibbonToggleButton}" IsChecked="True">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="24" Height="24" Fill="{DynamicResource IconSecurity}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock Text="Firewall&#x0a;[Active]" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            </StackPanel>
                                        </ToggleButton>

                                        <!-- Stack of 2 Mini Ribbon Buttons -->
                                        <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Button Style="{DynamicResource ClassicRibbonMiniButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="12" Height="12" Fill="{DynamicResource IconTimeSettings}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="NTP Sync"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource ClassicRibbonMiniButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="12" Height="12" Fill="{DynamicResource IconTerminal}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="SSH Console"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- 7. Windows 7 Command Link Buttons -->
                                    <TextBlock Text="7. WINDOWS 7 COMMAND LINK BUTTONS:"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Command Link 1 -->
                                        <Button Grid.Column="0"
                                                Style="{DynamicResource ClassicCommandLinkButton}"
                                                Click="OnCommandLinkClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Fill="#2E8B27"
                                                      VerticalAlignment="Top"
                                                      Margin="0,3,0,0"
                                                      Data="M 2,0 L 12,7 L 2,14 L 5,7 Z"/>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Deploy Configuration to All Switches" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    <TextBlock Text="Writes running config snapshot to Flash Bank 1 and pushes updates securely via SSH." FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Command Link 2 -->
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource ClassicCommandLinkButton}"
                                                Click="OnCommandLinkClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0"
                                                      Fill="#0D68B2"
                                                      VerticalAlignment="Top"
                                                      Margin="0,3,0,0"
                                                      Data="M 2,0 L 12,7 L 2,14 L 5,7 Z"/>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Rollback Firmware to Last Known Good Build" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    <TextBlock Text="Restores certified v4.1 build from secondary EEPROM and reboots backup supervisor." FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <!-- 8. Segmented Control / Button Group & Status Badges -->
                                    <TextBlock Text="8. SEGMENTED BUTTON GROUP &amp; STATUS BADGES:"
                                               FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,2,0,6"/>
                                    <WrapPanel>
                                        <!-- Connected Segmented Group: View Selector -->
                                        <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" CornerRadius="2" Height="24" Background="{DynamicResource ClassicCardBackground}" Margin="0,0,16,6" SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Segment 1: Selected / Sunken Active Aero -->
                                                <Border Background="{DynamicResource ClassicSidebarSelectedBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,1,0" Padding="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource IconWorkspace}" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Topology View" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Segment 2: Normal -->
                                                <Border Background="{DynamicResource ClassicCardBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,1,0" Padding="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource IconDeviceSettings}" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Device Table" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Segment 3: Normal -->
                                                <Border Background="{DynamicResource ClassicCardBackground}" Padding="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource IconDiscovery}" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Telemetry" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Status Badges & Pill Chips -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <Border Background="{DynamicResource ClassicBadgeSuccessBackground}" BorderBrush="{DynamicResource ClassicBadgeSuccessBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="8" Height="8" Fill="{DynamicResource IconStatusOnline}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Online (4)" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicBadgeSuccessForeground}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource ClassicBadgeWarningBackground}" BorderBrush="{DynamicResource ClassicBadgeWarningBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="8" Height="8" Fill="{DynamicResource IconAlarmWarning}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Flapping (1)" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicBadgeWarningForeground}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource ClassicBadgeCriticalBackground}" BorderBrush="{DynamicResource ClassicBadgeCriticalBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Rectangle Width="8" Height="8" Fill="{DynamicResource IconAlarmCritical}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Critical (1)" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicBadgeCriticalForeground}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource ClassicBadgeInfoBackground}" BorderBrush="{DynamicResource ClassicBadgeInfoBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="VLAN 100 [Production]" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicBadgeInfoForeground}"/>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- ============================================================= -->
                            <!-- 5. NOTIFICATION BANNERS & SYSTEM TOAST ALERTS                -->
                            <!-- ============================================================= -->
                            <GroupBox Header="Notifications, Banners &amp; Alerts"
                                      Style="{DynamicResource ClassicGroupBox}"
                                      Margin="0,0,0,16">
                                <StackPanel Margin="10,8">
                                    <!-- Informational Notification Banner -->
                                    <Border BorderBrush="{DynamicResource ClassicBadgeInfoBorder}" BorderThickness="1" Background="{DynamicResource ClassicBadgeInfoBackground}" CornerRadius="2" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="14" Height="14" Fill="{DynamicResource IconAlarmInfo}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Informational: Firmware update check completed. All switch units are running certified software builds." FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicBadgeInfoForeground}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{DynamicResource ClassicDismissButton}" Foreground="{DynamicResource ClassicBadgeInfoForeground}" Click="OnDismissNotificationClicked"/>
                                        </Grid>
                                    </Border>

                                    <!-- Success Notification Banner -->
                                    <Border BorderBrush="{DynamicResource ClassicBadgeSuccessBorder}" BorderThickness="1" Background="{DynamicResource ClassicBadgeSuccessBackground}" CornerRadius="2" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="14" Height="14" Fill="{DynamicResource IconAcknowledge}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Success: Configuration snapshot 'RunConfig_20260928.cfg' was saved and verified on Flash Bank 1." FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicBadgeSuccessForeground}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{DynamicResource ClassicDismissButton}" Foreground="{DynamicResource ClassicBadgeSuccessForeground}" Click="OnDismissNotificationClicked"/>
                                        </Grid>
                                    </Border>

                                    <!-- Warning Notification Banner -->
                                    <Border BorderBrush="{DynamicResource ClassicBadgeWarningBorder}" BorderThickness="1" Background="{DynamicResource ClassicBadgeWarningBackground}" CornerRadius="2" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="14" Height="14" Fill="{DynamicResource IconAlarmWarning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Warning: Switch port 1/0/24 link flap detected (3 reconnects within 60s). Check cable shielding." FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicBadgeWarningForeground}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{DynamicResource ClassicDismissButton}" Foreground="{DynamicResource ClassicBadgeWarningForeground}" Click="OnDismissNotificationClicked"/>
                                        </Grid>
                                    </Border>

                                    <!-- Critical Error Notification Banner -->
                                    <Border BorderBrush="{DynamicResource ClassicBadgeCriticalBorder}" BorderThickness="1" Background="{DynamicResource ClassicBadgeCriticalBackground}" CornerRadius="2" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Width="14" Height="14" Fill="{DynamicResource IconAlarmCritical}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Critical Alert: Redundant Power Supply (RPS-2) lost AC line voltage. System running on primary PSU." FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicBadgeCriticalForeground}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{DynamicResource ClassicDismissButton}" Foreground="{DynamicResource ClassicBadgeCriticalForeground}" Click="OnDismissNotificationClicked"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- ============================================================= -->
                            <!-- 5. THREE-COLUMN ENTERPRISE COMPONENT CATALOG                  -->
                            <!-- ============================================================= -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <!-- Column 1: Forms & Inputs -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Column 2: Lists, Trees & Navigation -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 1: FORMS, INPUTS & CONTROLS -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <!-- 1. Checkboxes & Radio Buttons -->
                                    <GroupBox Header="Checkboxes &amp; Radio Buttons" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox column -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CHECKBOXES:" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,6"/>
                                                <CheckBox Content="Enabled Checkbox" IsChecked="True" Margin="0,0,0,5"/>
                                                <CheckBox Content="Unchecked Checkbox" IsChecked="False" Margin="0,0,0,5"/>
                                                <CheckBox Content="Indeterminate State" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,0,5"/>
                                                <CheckBox Content="Disabled Checkbox" IsEnabled="False" IsChecked="True"/>
                                            </StackPanel>

                                            <!-- RadioButton column -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="RADIO BUTTONS:" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,6"/>
                                                <RadioButton GroupName="G1" Content="DHCP Auto IP" IsChecked="True" Margin="0,0,0,5"/>
                                                <RadioButton GroupName="G1" Content="Static IPv4 Address" Margin="0,0,0,5"/>
                                                <RadioButton GroupName="G1" Content="BOOTP / RARP Mode" Margin="0,0,0,5"/>
                                                <RadioButton GroupName="G1" Content="Disabled Radio" IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 2. Switches, Toggles & Stepper (NumericUpDown) -->
                                    <GroupBox Header="Switches, Toggles &amp; Numeric Stepper" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <!-- Toggle Switch 1 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Aero Pill Switch:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Auto MDI/MDIX Sensing" Style="{DynamicResource ClassicToggleSwitch}" IsChecked="True"/>

                                            <!-- Toggle Switch 2 -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Security Lock:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="802.1X Port Authentication" Style="{DynamicResource ClassicToggleSwitch}" IsChecked="False"/>

                                            <!-- NumericUpDown 1: VLAN ID -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="NumericUpDown (VLAN):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="105" Height="22" BorderBrush="{DynamicResource ClassicControlBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="18"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="VlanBox" Text="100" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ClassicTextTitle}" VerticalContentAlignment="Center" Padding="4,0" FontFamily="Segoe UI" FontSize="11"/>
                                                        <Grid Grid.Column="1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Button Grid.Row="0" Style="{DynamicResource ClassicNumericSpinnerButton}" BorderThickness="1,0,0,1" BorderBrush="{DynamicResource ClassicControlBorderBrush}" Tag="{Binding ElementName=VlanBox}" Click="OnNumericUpClicked">
                                                                <Path Data="M 0,3.5 L 3.5,0 L 7,3.5 Z" Fill="{DynamicResource ClassicTextTitle}" SnapsToDevicePixels="True"/>
                                                            </Button>
                                                            <Button Grid.Row="1" Style="{DynamicResource ClassicNumericSpinnerButton}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ClassicControlBorderBrush}" Tag="{Binding ElementName=VlanBox}" Click="OnNumericDownClicked">
                                                                <Path Data="M 0,0 L 3.5,3.5 L 7,0 Z" Fill="{DynamicResource ClassicTextTitle}" SnapsToDevicePixels="True"/>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="[ 1 - 4094 ]" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>

                                            <!-- NumericUpDown 2: Stepper (MTU) -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="NumericUpDown (MTU):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="105" Height="22" BorderBrush="{DynamicResource ClassicControlBorderBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="18"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="MtuInlineBox" Text="1500" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ClassicTextTitle}" VerticalContentAlignment="Center" Padding="4,0" FontFamily="Segoe UI" FontSize="11"/>
                                                        <Grid Grid.Column="1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Button Grid.Row="0" Style="{DynamicResource ClassicNumericSpinnerButton}" BorderThickness="1,0,0,1" BorderBrush="{DynamicResource ClassicControlBorderBrush}" Tag="{Binding ElementName=MtuInlineBox}" Click="OnNumericUpClicked">
                                                                <Path Data="M 0,3.5 L 3.5,0 L 7,3.5 Z" Fill="{DynamicResource ClassicTextTitle}" SnapsToDevicePixels="True"/>
                                                            </Button>
                                                            <Button Grid.Row="1" Style="{DynamicResource ClassicNumericSpinnerButton}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ClassicControlBorderBrush}" Tag="{Binding ElementName=MtuInlineBox}" Click="OnNumericDownClicked">
                                                                <Path Data="M 0,0 L 3.5,3.5 L 7,0 Z" Fill="{DynamicResource ClassicTextTitle}" SnapsToDevicePixels="True"/>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="Bytes" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 3. Dropdowns, DatePicker & ColorPicker -->
                                    <GroupBox Header="Dropdown, ComboBox, Date &amp; Color Picker" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <!-- Dropdown Standard -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Dropdown List:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="22" SelectedIndex="0" VerticalAlignment="Center">
                                                <ComboBoxItem Content="1000 Mbps Full Duplex (Auto)"/>
                                                <ComboBoxItem Content="100 Mbps Full Duplex"/>
                                                <ComboBoxItem Content="100 Mbps Half Duplex"/>
                                                <ComboBoxItem Content="10 Mbps Full Duplex"/>
                                                <ComboBoxItem Content="Disabled / Admin Down"/>
                                            </ComboBox>

                                            <!-- Editable ComboBox -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Editable ComboBox:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Height="22" IsEditable="True" Text="Custom MTU profile..." VerticalAlignment="Center">
                                                <ComboBoxItem Content="Default Ethernet (1500)"/>
                                                <ComboBoxItem Content="Jumbo Frame standard (9000)"/>
                                                <ComboBoxItem Content="Jumbo Frame max (9216)"/>
                                                <ComboBoxItem Content="PPPoE MTU (1492)"/>
                                            </ComboBox>

                                            <!-- DatePicker -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DatePicker / Calendar:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <DatePicker x:Name="DemoDatePicker" Grid.Row="2" Grid.Column="1" Style="{DynamicResource ClassicDatePicker}" Height="22" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedDate="2026-09-28"/>

                                            <!-- ColorPicker Swatches -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Color Picker Swatch:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" Background="#1D65AB" BorderBrush="#0F4375" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0" ToolTip="Aero Blue (#1D65AB)"/>
                                                <Border Width="18" Height="18" Background="#268C15" BorderBrush="#135208" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0" ToolTip="Emerald Green (#268C15)"/>
                                                <Border Width="18" Height="18" Background="#E09E0B" BorderBrush="#8C6002" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0" ToolTip="Amber Yellow (#E09E0B)"/>
                                                <Border Width="18" Height="18" Background="#D92B2B" BorderBrush="#851111" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0" ToolTip="Crimson Red (#D92B2B)"/>
                                                <Border Width="18" Height="18" Background="#4A5C6D" BorderBrush="#25323D" BorderThickness="1" CornerRadius="2" Margin="0,0,8,0" ToolTip="Slate Gray (#4A5C6D)"/>
                                                <TextBlock Text="[ 5 Presets ]" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- File Picker Inline -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="File Picker Input:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="C:\Configs\switch_backup.cfg" Height="22" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button Grid.Column="1" Content="Browse..." Height="22" Padding="6,1" Click="OnOpenFilePickerDialogClicked"/>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 4. ProgressBars & Sliders -->
                                    <GroupBox Header="ProgressBars &amp; Sliders" Style="{DynamicResource ClassicGroupBox}">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Green Progress -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Normal (Green):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ProgressBar Grid.Row="0" Grid.Column="1" Style="{DynamicResource ClassicProgressBar}" Height="12" Value="45" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="45%" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Blue Progress -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Transfer (Blue):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Style="{DynamicResource ClassicProgressBarBlue}" Height="12" Value="72" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="72%" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Amber Progress -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Warning (Amber):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ProgressBar Grid.Row="2" Grid.Column="1" Style="{DynamicResource ClassicProgressBarAmber}" Height="12" Value="86" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="86%" Foreground="{DynamicResource ClassicBadgeWarningForeground}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Red Progress -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Critical (Red):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ProgressBar Grid.Row="3" Grid.Column="1" Style="{DynamicResource ClassicProgressBarRed}" Height="12" Value="96" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="96%" Foreground="{DynamicResource ClassicBadgeCriticalForeground}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Grey Progress (Standby / Neutral) -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Standby (Gri / Gray):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <ProgressBar Grid.Row="4" Grid.Column="1" Style="{DynamicResource ClassicProgressBarGray}" Height="12" Value="50" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="50%" Foreground="{DynamicResource ClassicTextSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Multi-Segment Stacked Progress Bar (One continuous bar with only 1px separator dividers) -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Segmented Multi-Color:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                            <Border Grid.Row="5" Grid.Column="1" Height="12" BorderBrush="#8B9EB5" BorderThickness="1" CornerRadius="1" Background="#DEE5EC" VerticalAlignment="Center" SnapsToDevicePixels="True" ClipToBounds="True">
                                                <Grid Margin="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="20*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="15*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="15*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Normal (Green) 30% -->
                                                    <Border Grid.Column="0" BorderThickness="0" ToolTip="Normal (Green): 30%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#9AEF4E" Offset="0.0"/>
                                                                <GradientStop Color="#40D622" Offset="0.45"/>
                                                                <GradientStop Color="#24B812" Offset="0.5"/>
                                                                <GradientStop Color="#1A9308" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 1px Separator -->
                                                    <Rectangle Grid.Column="1" Width="1" Fill="#8B9EB5"/>

                                                    <!-- Transfer (Mavi) 20% -->
                                                    <Border Grid.Column="2" BorderThickness="0" ToolTip="Transfer (Mavi): 20%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#6ECBFD" Offset="0.0"/>
                                                                <GradientStop Color="#269DE6" Offset="0.45"/>
                                                                <GradientStop Color="#107EC7" Offset="0.5"/>
                                                                <GradientStop Color="#095996" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 1px Separator -->
                                                    <Rectangle Grid.Column="3" Width="1" Fill="#8B9EB5"/>

                                                    <!-- Warning (Amber) 15% -->
                                                    <Border Grid.Column="4" BorderThickness="0" ToolTip="Warning (Amber): 15%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FFE162" Offset="0.0"/>
                                                                <GradientStop Color="#FFB812" Offset="0.45"/>
                                                                <GradientStop Color="#F09B00" Offset="0.5"/>
                                                                <GradientStop Color="#C97B00" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 1px Separator -->
                                                    <Rectangle Grid.Column="5" Width="1" Fill="#8B9EB5"/>

                                                    <!-- Critical (Red) 10% -->
                                                    <Border Grid.Column="6" BorderThickness="0" ToolTip="Critical (Red): 10%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FF8484" Offset="0.0"/>
                                                                <GradientStop Color="#F03333" Offset="0.45"/>
                                                                <GradientStop Color="#D61818" Offset="0.5"/>
                                                                <GradientStop Color="#A30E0E" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 1px Separator -->
                                                    <Rectangle Grid.Column="7" Width="1" Fill="#8B9EB5"/>

                                                    <!-- Standby (Gri / Gray) 10% -->
                                                    <Border Grid.Column="8" BorderThickness="0" ToolTip="Standby (Gri): 10%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#CBD4DE" Offset="0.0"/>
                                                                <GradientStop Color="#9EAEBE" Offset="0.45"/>
                                                                <GradientStop Color="#889BB0" Offset="0.5"/>
                                                                <GradientStop Color="#657A90" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- 1px Separator -->
                                                    <Rectangle Grid.Column="9" Width="1" Fill="#8B9EB5"/>

                                                    <!-- Free Track Space 15% -->
                                                    <Border Grid.Column="10" BorderThickness="0" ToolTip="Free Space: 15%">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#DEE5EC" Offset="0.0"/>
                                                                <GradientStop Color="#EFF4F8" Offset="0.5"/>
                                                                <GradientStop Color="#F6FAFC" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Glossy top reflection across all segments -->
                                                    <Rectangle Grid.ColumnSpan="11" Height="5" VerticalAlignment="Top">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#70FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#10FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="6-Segmented" Foreground="{DynamicResource ClassicTextTitle}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                            <!-- Sliders (Horizontal & Vertical side-by-side) -->
                                            <Grid Grid.Row="6" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Aero Sliders (H / V):" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                                                <!-- Horizontal Slider -->
                                                <Slider x:Name="InlineSlider" Grid.Column="1" Style="{DynamicResource ClassicSlider}" Orientation="Horizontal" Minimum="0" Maximum="100" Value="60" TickFrequency="10" TickPlacement="BottomRight" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=InlineSlider, StringFormat={}{0:0}%}" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                                <!-- Vertical Slider (Fixed container width to eliminate layout jitter) -->
                                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Grid.Column="0" x:Name="InlineVerticalSlider" Style="{DynamicResource ClassicSlider}" Orientation="Vertical" Height="50" Minimum="0" Maximum="100" Value="75" TickFrequency="25" TickPlacement="BottomRight"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=InlineVerticalSlider, StringFormat={}{0:0}%}" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="10" TextAlignment="Left"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>


                                <!-- COLUMN 2: LISTS, TREES, NAVIGATION, ACCORDION & TABLES -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">

                                    <!-- 1. Breadcrumb & Pagination Navigation -->
                                    <GroupBox Header="Breadcrumb Navigation &amp; Pagination" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <StackPanel Margin="8,6">
                                            <!-- Breadcrumb Strip -->
                                            <TextBlock Text="BREADCRUMB PATH:" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,4"/>
                                            <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="1" Background="{DynamicResource ClassicCardBackground}" CornerRadius="2" Padding="6,3" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Network Infrastructure"/>
                                                    <TextBlock Text="›" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" Margin="2,0"/>
                                                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Core Switches"/>
                                                    <TextBlock Text="›" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" Margin="2,0"/>
                                                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="DGS-1510-28X"/>
                                                    <TextBlock Text="›" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" Margin="2,0"/>
                                                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Port 1/0/24 (Trunk)" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Pagination Controls -->
                                            <TextBlock Text="PAGINATION BAR:" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,4"/>
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="« First"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="‹ Prev"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="1" Tag="Active"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="2"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="3"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="4"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="Next ›"/>
                                                    <Button Style="{DynamicResource ClassicPaginationButton}" Content="Last »"/>
                                                </StackPanel>

                                                <TextBlock Text="Showing 1-10 of 48 items" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextSubtitle}" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 2. ListBox & TreeView (Sidebar Component) -->
                                    <GroupBox Header="ListBox &amp; TreeView (Hierarchical Nodes)" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,14">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ListBox with Icons -->
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="LISTBOX ITEMS:" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,0,0,4"/>
                                                <ListBox Height="130" BorderBrush="{DynamicResource ClassicControlBorderBrush}" BorderThickness="1">
                                                    <ListBoxItem IsSelected="True">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconPort}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Port 1 (1000M Full)" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ListBoxItem>
                                                    <ListBoxItem>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconPort}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Port 2 (PoE 15.4W)" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ListBoxItem>
                                                    <ListBoxItem>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconPort}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Port 24 (Trunk Uplink)" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ListBoxItem>
                                                    <ListBoxItem>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconGeneral}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Management Console" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ListBoxItem>
                                                </ListBox>
