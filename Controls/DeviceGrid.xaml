                                            <TextBlock Text="optimal ping" FontFamily="Segoe UI" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Statistic Card - Packet Loss Rate & Badge -->
