<UserControl x:Class="ClassicAeroStudio.Controls.WizardHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="600">
    <Border BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" Height="28" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step 1: Time Settings -->
            <Grid Grid.Column="0">
                <!-- Chevron background for Step 1 -->
                <Path x:Name="Step1Path"
                      Stretch="Fill"
                      Stroke="#A4C1E4"
                      StrokeThickness="0.6"
                      Data="M 0,0 L 285,0 L 300,14 L 285,28 L 0,28 Z">
                    <Path.Fill>
                        <LinearGradientBrush x:Name="Step1Brush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E4EFFD" Offset="0.0"/>
                            <GradientStop Color="#C9DFF9" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Step 1 circular indicator -->
                    <Border x:Name="Step1Badge"
                            Width="16" Height="16"
                            CornerRadius="8"
                            Background="#1867B8"
                            Margin="0,0,6,0">
                        <TextBlock x:Name="Step1BadgeText"
                                   Text="1"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock x:Name="Step1Text"
                               Text="1. Time Settings"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ClassicWizardActiveForeground}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Step 2: Confirm Summary -->
            <Grid Grid.Column="1" Margin="-12,0,0,0">
                <!-- Chevron background for Step 2 -->
                <Path x:Name="Step2Path"
                      Stretch="Fill"
                      Fill="{DynamicResource ClassicWizardInactiveBackground}"
                      Stroke="{DynamicResource ClassicWizardInactiveBorder}"
                      StrokeThickness="0.6">
                    <Path.Data>
                        <PathGeometry Figures="M 0,0 L 290,0 L 290,28 L 0,28 L 15,14 Z"/>
                    </Path.Data>
                </Path>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- Step 2 circular indicator -->
                    <Border x:Name="Step2Badge"
                            Width="16" Height="16"
                            CornerRadius="8"
                            Background="{DynamicResource ClassicWizardInactiveBadge}"
                            Margin="0,0,6,0">
                        <TextBlock Text="2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                    </Border>
                    <TextBlock x:Name="Step2Text"
                               Text="2. Confirm Summary"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ClassicWizardInactiveForeground}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
