<Window x:Class="ClassicAeroStudio.Views.DiagnosticPingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping Diagnostics - 192.168.1.20"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="470" Width="580"
        MinHeight="450" MinWidth="565"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <!-- 1. Header banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Diagnostic Parameters Form -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Terminal Output Console -->
            <RowDefinition Height="*"/>
            <!-- 4. Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner (Windows 7 Utility Header) -->
        <Border Grid.Row="0"
                Background="{DynamicResource ClassicSubHeaderBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="10,8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0"
                           Width="28" Height="28"
                           Fill="{DynamicResource IconSearch}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ICMP Ping Diagnostic Utility"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource ClassicTextTitle}"/>
                    <TextBlock Text="Verify layer-3 network connectivity and packet response latency."
                               Foreground="{DynamicResource ClassicTextSubtitle}"
                               FontSize="10.5"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Diagnostic Parameters Form -->
        <GroupBox Grid.Row="1" Header="Diagnostic Parameters" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,10">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <!-- Form Inputs Area (Flexible, auto-scaling) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Action Buttons Column (Auto-width - Never compressed or overlapped) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Input Fields Grid -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Target IP -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target IP:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTargetIp" Grid.Row="0" Grid.Column="1" Text="192.168.1.20" Style="{DynamicResource ClassicTextBox}"/>

                    <!-- Packet Count -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Packet Count:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbCount" Grid.Row="0" Grid.Column="4" Style="{DynamicResource ClassicComboBox}" SelectedIndex="0" MinWidth="95">
                        <ComboBoxItem Content="4 Packets"/>
                        <ComboBoxItem Content="8 Packets"/>
                        <ComboBoxItem Content="16 Packets"/>
                    </ComboBox>

                    <!-- Buffer Size -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Buffer Size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbSize" Grid.Row="1" Grid.Column="1" Style="{DynamicResource ClassicComboBox}" SelectedIndex="0">
                        <ComboBoxItem Content="32 Bytes (Standard)"/>
                        <ComboBoxItem Content="64 Bytes"/>
                        <ComboBoxItem Content="128 Bytes"/>
                        <ComboBoxItem Content="1024 Bytes"/>
                    </ComboBox>

                    <!-- Timeout -->
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Timeout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbTimeout" Grid.Row="1" Grid.Column="4" Style="{DynamicResource ClassicComboBox}" SelectedIndex="0" MinWidth="95">
                        <ComboBoxItem Content="1000 ms"/>
                        <ComboBoxItem Content="2000 ms"/>
                        <ComboBoxItem Content="5000 ms"/>
                    </ComboBox>
                </Grid>

                <!-- Action Buttons: Start Ping / Clear Log (Independent Right Column) -->
                <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Content="Start Ping"
                            Style="{DynamicResource ClassicDefaultButton}"
                            Width="85"
                            Height="23"
                            Click="OnStartPingClicked"/>

                    <Button Grid.Row="1"
                            Content="Clear Log"
                            Style="{DynamicResource ClassicStandardButton}"
                            Width="85"
                            Height="23"
                            Click="OnClearClicked"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 3. Output Console -->
        <GroupBox Grid.Row="2" Header="ICMP Response Console" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,10">
            <TextBox x:Name="TxtConsole"
                     Style="{DynamicResource ClassicMultiLineTextBox}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Margin="4"
                     TextWrapping="NoWrap"/>
        </GroupBox>

        <!-- 4. Bottom Action Bar -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" Margin="2,0,6,0"/>
                <TextBlock x:Name="TxtStatus" Text="Ready - Target 192.168.1.20 responsive" Foreground="#335577" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Content="Close"
                    Style="{DynamicResource ClassicStandardButton}"
                    Width="75"
                    HorizontalAlignment="Right"
                    Click="OnCloseClicked"/>
        </Grid>

    </Grid>
</Window>
