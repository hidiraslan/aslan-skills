<Window x:Class="ClassicAeroStudio.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classic Aero UI Studio - Device Reboot"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="230" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Background="{DynamicResource ClassicCardBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Task Dialog Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- 2. Command Button Footer Bar -->
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- 1. Upper Content -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Rectangle Grid.Column="0"
                       Width="32" Height="32"
                       Fill="{DynamicResource IconReboot}"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       Margin="0,2,0,0"/>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="Are you sure you want to reboot the selected device?"
                           FontFamily="Segoe UI"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Device 'DGS-1210-20' (192.168.1.20) will perform a full system reset. Network ports and traffic forwarding will be temporarily interrupted for approximately 45-60 seconds."
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="{DynamicResource ClassicTextBody}"
                           TextWrapping="Wrap"
                           LineHeight="16"
                           Margin="0,0,0,12"/>

                <CheckBox Content="Do not show this confirmation dialog again"
                          Style="{StaticResource ClassicCheckBox}"/>
            </StackPanel>
        </Grid>

        <!-- 2. Bottom Command Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource ClassicCanvasBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="Reboot Device"
                        Style="{StaticResource ClassicDefaultButton}"
                        Width="95"
                        Height="24"
                        Margin="0,0,8,0"
                        Click="OnConfirmClicked"/>
                <Button Content="Cancel"
                        Style="{StaticResource ClassicStandardButton}"
                        Width="75"
                        Height="24"
                        Click="OnCancelClicked"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
