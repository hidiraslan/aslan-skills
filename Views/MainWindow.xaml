<Window x:Class="ClassicAeroStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:ClassicAeroStudio.Controls"
        mc:Ignorable="d"
        Title="Classic Aero UI Studio — Windows Enterprise Design System"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1100" Height="700"
        MinWidth="950" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Background="{DynamicResource ClassicCanvasBackground}">
        <Grid.RowDefinitions>
            <!-- 1. Top Ribbon Area (Application button, Tabs, and Action Toolbar) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Device List & Grid Area -->
            <RowDefinition Height="*"/>
            <!-- 3. Classic Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Ribbon Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource ClassicRibbonBackground}"
                BorderBrush="{DynamicResource ClassicBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Tabs row with App button -->
                    <RowDefinition Height="26"/>
                    <!-- Ribbon Action Toolbar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ribbon Tabs Row -->
                <Grid Grid.Row="0" Margin="4,2,4,0">
                    <Grid.ColumnDefinitions>
                        <!-- Top-Left Pill Application Button -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Ribbon Tabs -->
                        <ColumnDefinition Width="*"/>
                        <!-- Dark Aero / Light Aero Mode Toggle Pill Switch -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Application Pill Button (Windows 7 / WordPad style blue dropdown menu) -->
                    <Button Grid.Column="0"
                            x:Name="AppMenuButton"
                            Style="{DynamicResource ClassicAppPillButton}"
                            Margin="0,0,4,0"
                            VerticalAlignment="Bottom"
                            Click="OnAppMenuButtonClicked"
                            ToolTip="Application Menu">
                        <Button.ContextMenu>
                            <ContextMenu Style="{DynamicResource ClassicContextMenu}">
                                <!-- 1. New Discovery / Scan -->
                                <MenuItem Header="New Network Scan"
                                          InputGestureText="Ctrl+N"
                                          Click="OnNewScanClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconDiscovery}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 2. Open Topology -->
                                <MenuItem Header="Open Network Topology..."
                                          InputGestureText="Ctrl+O"
                                          Click="OnOpenTopologyClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconBackupRestore}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 3. Save Device List -->
                                <MenuItem Header="Save Device List"
                                          InputGestureText="Ctrl+S"
                                          Click="OnSaveDeviceListClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconSave}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 4. Export Inventory -->
                                <MenuItem Header="Export Inventory (CSV / XML)..."
                                          Click="OnExportClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconPort}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 5. Print Inventory -->
                                <MenuItem Header="Print Device Summary..."
                                          InputGestureText="Ctrl+P"
                                          Click="OnPrintClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconGeneral}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 6. Application Options / Settings -->
                                <MenuItem Header="Application Options (List Mode)..."
                                          InputGestureText="F10"
                                          Click="OnSettingsRequested">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconSettings}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <!-- 6b. Tile Settings / Preferences -->
                                <MenuItem Header="Preferences (Tile Mode)..."
                                          Click="OnTileSettingsRequested">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconDisplay}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 7. About -->
                                <MenuItem Header="About Classic Aero UI Studio..."
                                          Click="OnAboutClicked">
                                    <MenuItem.Icon>
                                        <Rectangle Width="16" Height="16" Fill="{DynamicResource IconAppLogo}"/>
                                    </MenuItem.Icon>
                                </MenuItem>

                                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>

                                <!-- 8. Exit -->
                                <MenuItem Header="Exit"
                                          InputGestureText="Alt+F4"
                                          Click="OnExitClicked"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Ribbon Tabs: "Common", "Advanced" -->
                    <TabControl x:Name="RibbonTabStrip"
                                Grid.Column="1"
                                Style="{DynamicResource ClassicRibbonTabStrip}"
                                VerticalAlignment="Bottom"
                                SelectionChanged="OnRibbonTabSelectionChanged">
                        <TabItem Header="Common"
                                 Style="{DynamicResource ClassicRibbonTabItem}"
                                 IsSelected="True"/>
                        <TabItem Header="Advanced"
                                 Style="{DynamicResource ClassicRibbonTabItem}"/>
                    </TabControl>

                    <!-- Dark Aero / Light Aero Mode Toggle Pill Switch -->
                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,2"
                            SnapsToDevicePixels="True">
                        <Button x:Name="ThemePillSwitch"
                                Height="22"
                                Padding="8,1"
                                Cursor="Hand"
                                Click="OnThemePillSwitchClicked"
                                Style="{DynamicResource ClassicThemeTogglePill}"
                                ToolTip="Toggle between Windows Classic Aero and Dark Aero Themes">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtThemeLabel" Text="Dark Aero" FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <!-- Ribbon Command Bar Body (Switches between Common and Advanced) -->
                <Grid Grid.Row="1">
                    <!-- Common Ribbon Toolbar -->
                    <ctrl:ClassicToolbar x:Name="CommonToolbar"
                                         Visibility="Visible"
                                         TimeSettingsRequested="OnTimeSettingsRequested"
                                         DeviceSettingsRequested="OnDeviceSettingsRequested"
                                         InputControlsRequested="OnInputControlsRequested"
                                         StudioRequested="OnStudioRequested"
                                         ProgressBarsRequested="OnProgressBarsRequested"
                                         SplitMenuRequested="OnSplitMenuRequested"
                                         AlertDialogRequested="OnAlertDialogRequested"
                                         SettingsRequested="OnSettingsRequested"
                                         TileSettingsRequested="OnTileSettingsRequested"
                                         RebootRequested="OnRebootRequested"
                                         PingRequested="OnPingRequested"/>

                    <!-- Advanced Ribbon Toolbar -->
                    <ctrl:AdvancedToolbar x:Name="AdvancedToolbar"
                                          Visibility="Collapsed"
                                          SettingsRequested="OnSettingsRequested"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Device Grid & List Content Area -->
        <ctrl:DeviceGrid Grid.Row="1"
                         x:Name="DeviceGridArea"
                         Margin="0,0,0,0"
                         DeviceSettingsRequested="OnDeviceSettingsRequested"
                         TimeSettingsRequested="OnTimeSettingsRequested"
                         RebootRequested="OnRebootRequested"
                         PingRequested="OnPingRequested"/>

        <!-- 3. Bottom Classic Status Bar -->
        <StatusBar Grid.Row="2" Style="{DynamicResource ClassicStatusBar}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ready" Foreground="{DynamicResource ClassicTextTitle}" Margin="4,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{DynamicResource ClassicStatusBarSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="1 device detected" Foreground="{DynamicResource ClassicTextSubtitle}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <!-- Classic Windows status bar grip indicator -->
                <Grid Width="16" Height="14" Margin="0,0,2,0">
                    <Path Fill="{DynamicResource ClassicDividerBrush}" Data="M 12,2 L 14,2 L 14,4 L 12,4 Z M 8,6 L 10,6 L 10,8 L 8,8 Z M 12,6 L 14,6 L 14,8 L 12,8 Z M 4,10 L 6,10 L 6,12 L 4,12 Z M 8,10 L 10,10 L 10,12 L 8,12 Z M 12,10 L 14,10 L 14,12 L 12,12 Z"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
