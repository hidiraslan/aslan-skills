<Window x:Class="ClassicAeroStudio.Views.ExplorerLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Explorer Shell — Storage, Backups &amp; Archive Browser"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="540" Width="820"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Classic Menu Bar (File, Edit, View, Tools, Help) -->
            <RowDefinition Height="22"/>
            <!-- 2. Address / Breadcrumb Bar & Quick Search -->
            <RowDefinition Height="34"/>
            <!-- 3. Work Area: Splitter (Left Tree + Right Content) -->
            <RowDefinition Height="*"/>
            <!-- 4. Windows 7 Detail Pane / Info Strip -->
            <RowDefinition Height="46"/>
            <!-- 5. Classic Status Bar -->
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Classic Menu Bar -->
        <Menu Grid.Row="0" Style="{DynamicResource ClassicMenu}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Folder" InputGestureText="Ctrl+Shift+N"/>
                <MenuItem Header="_Export Selection..."/>
                <Separator Style="{DynamicResource ClassicMenuSeparator}"/>
                <MenuItem Header="_Close" Click="OnCloseClicked"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Select All" InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Invert Selection"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Large Icons"/>
                <MenuItem Header="_Details (DataGrid)" IsChecked="True"/>
                <MenuItem Header="_Refresh" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Map Network Drive..."/>
                <MenuItem Header="_Folder Options..."/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Explorer Layout..."/>
            </MenuItem>
        </Menu>

        <!-- Row 1: Address / Breadcrumb Bar + Search -->
        <Border Grid.Row="1" Background="{DynamicResource ClassicCardBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,1" SnapsToDevicePixels="True">
            <Grid Margin="6,0,8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Chevrons (Back / Forward) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Button Style="{DynamicResource ClassicToolbarButton}" Width="24" Height="24" Padding="0" ToolTip="Geri">
                        <Path Width="6" Height="10" Stretch="Fill"
                              Data="M 5,0 L 0,5 L 5,10"
                              Stroke="{DynamicResource ClassicTextTitle}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{DynamicResource ClassicToolbarButton}" Width="24" Height="24" Padding="0" Margin="2,0,0,0" ToolTip="Forward">
                        <Path Width="6" Height="10" Stretch="Fill"
                              Data="M 0,0 L 5,5 L 0,10"
                              Stroke="{DynamicResource ClassicTextTitle}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Breadcrumb Address Bar -->
                <Border Grid.Column="1" Background="{DynamicResource ClassicInnerBackground}" BorderBrush="{DynamicResource ClassicBorderBrush}" BorderThickness="1" CornerRadius="2" Height="24" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="14" Height="14" Fill="{DynamicResource IconFolder}" Margin="6,0,4,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Network Storage" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicTextTitle}"/>
                            <Path Data="M 0,0 L 3,3 L 0,6" Stroke="{DynamicResource ClassicTextSubtitle}" StrokeThickness="1" Margin="6,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Backups &amp; Flash Archives" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}"/>
                            <Path Data="M 0,0 L 3,3 L 0,6" Stroke="{DynamicResource ClassicTextSubtitle}" StrokeThickness="1" Margin="6,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Switch-Cluster-01" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource ClassicSelectionBlue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search Box -->
                <TextBox Grid.Column="2" Style="{DynamicResource ClassicSearchBox}" Height="24" Tag="Search Archives..."/>
            </Grid>
        </Border>

        <!-- Row 2: Split Work Area (Folder TreeView + File/Item DataGrid) -->
        <Grid Grid.Row="2" Background="{DynamicResource ClassicCardBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left TreeView Pane (Favorites & Folder Hierarchy) -->
            <Border Grid.Column="0" Background="{DynamicResource ClassicInnerBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,0,1,0" SnapsToDevicePixels="True">
                <TreeView Style="{DynamicResource ClassicTreeView}"
                          Margin="4"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RequestBringIntoView="OnTreeViewRequestBringIntoView">
                    <TreeViewItem Header="Favorites" IsExpanded="True">
                        <TreeViewItem Header="Recent Backups" IsSelected="True"/>
                        <TreeViewItem Header="Firmware Binaries"/>
                        <TreeViewItem Header="Crash Dumps &amp; Logs"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Network Switches" IsExpanded="True">
                        <TreeViewItem Header="Core-Switch-01 (192.168.1.1)"/>
                        <TreeViewItem Header="Dist-Switch-East (192.168.1.20)"/>
                        <TreeViewItem Header="Edge-Switch-Floor2 (192.168.1.35)"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Storage Flash Banks">
                        <TreeViewItem Header="Flash Bank 1 (Primary)"/>
                        <TreeViewItem Header="Flash Bank 2 (EEPROM)"/>
                    </TreeViewItem>
                </TreeView>
            </Border>

            <!-- 1px Clean Aero GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource ClassicDividerBrush}" ResizeBehavior="PreviousAndNext"/>

            <!-- Right Content Area (Files DataGrid) -->
            <DataGrid x:Name="ExplorerDataGrid"
                      Grid.Column="2"
                      Style="{DynamicResource ClassicDataGrid}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{DynamicResource ClassicGridLineVertical}"
                      HorizontalGridLinesBrush="{DynamicResource ClassicGridLineHorizontal}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      RowHeight="24"
                      Background="{DynamicResource ClassicCardBackground}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32" Header="" CellStyle="{DynamicResource ClassicDataGridCellCentered}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFile}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="File Name" Width="240" MinWidth="180" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Tarih (Date Modified)" Width="130" MinWidth="110" Binding="{Binding Date}"/>
                    <DataGridTextColumn Header="Type" Width="110" MinWidth="90" Binding="{Binding Type}"/>
                    <DataGridTextColumn Header="Boyut (Size)" Width="90" MinWidth="70" Binding="{Binding Size}"/>
                    <DataGridTextColumn Header="Durum (Integrity)" Width="160" MinWidth="130" Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="Konum (Storage Target)" Width="180" MinWidth="140" Binding="{Binding Location}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Row 3: Windows 7 Detail Pane / Summary Strip -->
        <Border Grid.Row="3" Background="{DynamicResource ClassicSubHeaderBackground}" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True" Padding="12,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="28" Height="28" Fill="{DynamicResource IconSave}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Running-Config-Snapshot-20261002.bin" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ClassicTextTitle}"/>
                    <TextBlock Text="SHA256: 8f9b2c... | Firmware v4.1 Compliant | Flash Bank 1" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource ClassicTextSubtitle}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource ClassicStandardButton}" Content="Restore..." Height="22" Padding="8,1" Margin="0,0,6,0"/>
                    <Button Style="{DynamicResource ClassicStandardButton}" Content="Verify Hash" Height="22" Padding="8,1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Status Bar -->
        <StatusBar Grid.Row="4" Style="{DynamicResource ClassicStatusBar}">
            <StatusBarItem>
                <TextBlock Text="6 items"/>
            </StatusBarItem>
            <Separator Style="{DynamicResource ClassicStatusBarSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="1 item selected: 2.45 MB"/>
            </StatusBarItem>
            <Separator Style="{DynamicResource ClassicStatusBarSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Fill="{DynamicResource IconStatusOnline}" Margin="0,0,4,0"/>
                    <TextBlock Text="Storage Online (NVMe / Flash)"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
