<Window x:Class="ClassicAeroStudio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About Classic Aero UI Studio"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Width="440" Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <!-- Content Header -->
            <RowDefinition Height="*"/>
            <!-- Bottom Button -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App Logo Icon -->
            <Rectangle Grid.Column="0" Width="42" Height="42"
                       Fill="{DynamicResource IconAppLogo}"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0"/>

            <!-- Information Details -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Classic Aero UI Studio"
                           FontFamily="Segoe UI, Tahoma, sans-serif"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ClassicTextTitle}"/>
                <TextBlock Text="Version 2.0 (Classic Windows Aero Design System)"
                           FontSize="11"
                           Foreground="{DynamicResource ClassicTextSubtitle}"
                           Margin="0,2,0,8"/>

                <TextBlock Text="Windows Classic Aero Enterprise UI Showcase &amp; Design Framework"
                           FontSize="11"
                           Foreground="{DynamicResource ClassicTextBody}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Production WPF Component Library for Enterprise Desktop Software"
                           FontSize="10.5"
                           Foreground="{DynamicResource ClassicTextSubtitle}"
                           Margin="0,0,0,10"/>

                <Border BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>

                <TextBlock Text="Target Framework: .NET 10.0 / Windows Presentation Foundation"
                           FontSize="10"
                           Foreground="{DynamicResource ClassicTextSubtitle}"/>
                <TextBlock Text="Rendering: Display Mode / ClearType Fixed Hinting"
                           FontSize="10"
                           Foreground="{DynamicResource ClassicTextSubtitle}"/>
            </StackPanel>
        </Grid>

        <!-- OK Button -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource ClassicDividerBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <Button Content="OK"
                    Style="{StaticResource ClassicDefaultButton}"
                    Width="75"
                    HorizontalAlignment="Right"
                    Click="OnCloseClicked"/>
        </Border>
    </Grid>
</Window>
