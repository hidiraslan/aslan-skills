<!-- ========================================================================= -->
<!-- CLASSIC AERO UI - TASK DIALOG / CONFIRMATION MODAL TEMPLATE               -->
<!-- Classic Windows Vista/7 TaskDialog: 32x32 Icon, Navy headline, body text, -->
<!-- and a separate command footer bar (#F0F4F8 with #D0DFEE top border).      -->
<!-- ========================================================================= -->
<Window x:Class="YourApp.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Confirmation"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="230" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Task Dialog Main Content Area (White) -->
            <RowDefinition Height="*"/>
            <!-- 2. Command Button Footer Bar (Classic Gray-Blue) -->
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- 1. Upper Content Area -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 32x32 Vector Action / Alert Icon -->
            <Rectangle Grid.Column="0"
                       Width="32" Height="32"
                       Fill="{DynamicResource IconReboot}"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       Margin="0,2,0,0"/>

            <!-- Headline & Explanatory Body -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock Text="Are you sure you want to perform this operation?"
                           FontFamily="Segoe UI"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#003399"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="This action will apply pending configuration changes and restart the active service. Network connectivity may be temporarily interrupted for approximately 30-45 seconds."
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#222222"
                           TextWrapping="Wrap"
                           LineHeight="16"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>

        <!-- 2. Lower Command Footer Bar -->
        <Border Grid.Row="1"
                Background="#F0F4F8"
                BorderBrush="#D0DFEE"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Yes, Proceed" Width="85" Height="24" IsDefault="True" Margin="0,0,8,0" Style="{StaticResource ClassicPrimaryButton}"/>
                <Button Content="Cancel" Width="75" Height="24" IsCancel="True" Style="{StaticResource ClassicSecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
