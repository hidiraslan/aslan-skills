<Window x:Class="ClassicAeroStudio.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Authentication &amp; Security"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="315" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top White Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Form Body (Canvas #F4F6F9) -->
            <RowDefinition Height="*"/>
            <!-- 3. Command Button Footer Bar -->
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Banner (White with bottom dividing border) -->
        <Border Grid.Row="0"
                Background="{DynamicResource ClassicSubHeaderBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0"
                           Width="28" Height="28"
                           Fill="{DynamicResource IconKey}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Network Assistant - Administrator Login"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ClassicTextTitle}"/>
                    <TextBlock Text="Enter your credentials to access managed switch security controls."
                               FontFamily="Segoe UI"
                               FontSize="10.5"
                               Foreground="{DynamicResource ClassicTextSubtitle}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Form Body on ClassicCanvasBackground (#F4F6F9) -->
        <Grid Grid.Row="1" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Username -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="admin" Style="{DynamicResource ClassicTextBox}" Height="22" VerticalAlignment="Center"/>

            <!-- Password -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}" FontWeight="SemiBold"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" Height="22" VerticalAlignment="Center"/>

            <!-- Auth Realm / Domain -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Domain / Realm:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Style="{DynamicResource ClassicComboBox}" Height="22" SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem Content="Local Device Database (admin)"/>
                <ComboBoxItem Content="RADIUS Server (Radius-Primary)"/>
                <ComboBoxItem Content="TACACS+ AAA Cluster"/>
                <ComboBoxItem Content="Active Directory / LDAP (HQ-CORP)"/>
            </ComboBox>

            <!-- Remember me checkbox -->
            <CheckBox Grid.Row="3" Grid.Column="1" Content="Remember username on this PC" IsChecked="True" Style="{DynamicResource ClassicCheckBox}" VerticalAlignment="Center"/>

            <!-- TLS Toggle switch -->
            <CheckBox Grid.Row="4" Grid.Column="1" Content="Enforce TLS 1.3 encrypted management session" IsChecked="True" Style="{DynamicResource ClassicToggleSwitch}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 3. Footer Action Bar (Windows 7 Task Dialog Gray) -->
        <Border Grid.Row="2"
                Background="{DynamicResource ClassicCanvasBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Firmware build: v4.21.B012"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Log In"
                            Style="{DynamicResource ClassicDefaultButton}"
                            IsDefault="True"
                            Width="75" Height="24"
                            Margin="0,0,8,0"
                            Click="OnLoginClicked"/>

                    <Button Content="Cancel"
                            Style="{DynamicResource ClassicStandardButton}"
                            IsCancel="True"
                            Width="75" Height="24"
                            Click="OnCancelClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
