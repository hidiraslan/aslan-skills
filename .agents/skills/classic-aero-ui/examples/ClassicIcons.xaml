    <!-- Green Glossy LED Indicator -->
    <DrawingBrush x:Key="IconStatusOnline" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Outer glow / drop shadow -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#40339900" Offset="0"/>
                            <GradientStop Color="#00339900" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Main sphere body -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.4,0.35" GradientOrigin="0.4,0.35" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#A4F94C" Offset="0.0"/>
                            <GradientStop Color="#4AD818" Offset="0.4"/>
                            <GradientStop Color="#189602" Offset="0.8"/>
                            <GradientStop Color="#0C6202" Offset="1.0"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0C5C00" Thickness="0.8"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="5" RadiusY="5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Top-left glossy reflection / highlight glint -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#E6FFFFFF" Offset="0"/>
                            <GradientStop Color="#1AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="6.8,5.8" RadiusX="2.6" RadiusY="1.4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

