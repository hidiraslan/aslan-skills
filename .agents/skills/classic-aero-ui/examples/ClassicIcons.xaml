    <!-- App Logo Icon (Classic Windows Aero UI Studio Crystal Badge) -->
    <DrawingBrush x:Key="IconAppLogo" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- 1. Outer 3D Drop Shadow / Deep Bevel -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1B64AC" Offset="0"/>
                            <GradientStop Color="#082A4D" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#051D36" Thickness="0.8"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,18,18" RadiusX="3" RadiusY="3"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 2. Inner Aero Glass Plate -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4DA4F7" Offset="0"/>
                            <GradientStop Color="#1A77D2" Offset="0.45"/>
                            <GradientStop Color="#0B4B8E" Offset="0.55"/>
                            <GradientStop Color="#093B72" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,1,16,16" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 3. Upper Specular Gloss Arc -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                            <GradientStop Color="#25FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 1,1 L 17,1 L 17,8 C 12,6.5 6,6.5 1,8 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 4. Windows Aero 4-Pane Studio Frame (Pure White & Cyan Gloss) -->
                <!-- Top-Left Pane -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3.5,3.5,4.8,4.2" RadiusX="0.8" RadiusY="0.8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Top-Right Pane (Cyan Accent) -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#7DE1FF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9.7,3.5,4.8,4.2" RadiusX="0.8" RadiusY="0.8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Bottom-Left Pane -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#7DE1FF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3.5,9.2,4.8,5.2" RadiusX="0.8" RadiusY="0.8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Bottom-Right Pane -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9.7,9.2,4.8,5.2" RadiusX="0.8" RadiusY="0.8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Fine Window Crosshair Dividers -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#093B72" Thickness="0.7"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="8.9,3.5" EndPoint="8.9,14.4"/>
                            <LineGeometry StartPoint="3.5,8.4" EndPoint="14.5,8.4"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

