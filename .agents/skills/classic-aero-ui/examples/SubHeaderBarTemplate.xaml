<!-- ========================================================================= -->
<!-- CLASSIC AERO UI - SUB-HEADER BAR REFERENCE TEMPLATE                       -->
<!-- Use this exact layout on Row 0 of every view panel or module tab.         -->
<!-- ========================================================================= -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Grid.Row="0"
        Height="34"
        BorderBrush="#D0DFEE"
        BorderThickness="0,0,0,1"
        Background="#FFFFFF"
        SnapsToDevicePixels="True">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  Focusable="False"
                  BorderThickness="0">
        <Grid Margin="10,0,10,0" VerticalAlignment="Center" MinWidth="750">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Titles & Badges -->
                <ColumnDefinition Width="Auto"/>
                <!-- Column 1: Flexible Spacer -->
                <ColumnDefinition Width="*" MinWidth="16"/>
                <!-- Column 2: Actions & Search Controls -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Module Title & Enterprise Subtitle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Module Name &amp; Overview"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1E395B"
                           VerticalAlignment="Center"/>
                <TextBlock Text="— Enterprise Description, Telemetry &amp; Status Controls"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#6B88A4"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right: Action Buttons, ComboBox, Search Box -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Refresh Button -->
                <Button Margin="0,0,6,0" Padding="8,1" Height="22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="13" Height="13" Fill="{DynamicResource IconRefresh}" Margin="0,0,4,0"/>
                        <TextBlock Text="Refresh" FontFamily="Segoe UI" FontSize="11" Foreground="#1E395B"/>
                    </StackPanel>
                </Button>

                <!-- Search Box -->
                <TextBox Width="140" Height="22" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Border>
