<Window x:Class="ClassicAeroStudio.Views.TimeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:ClassicAeroStudio.Controls"
        mc:Ignorable="d"
        Title="Time Settings"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="510" Width="780"
        MinHeight="490" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <!-- 1. Wizard Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Settings Content Area -->
            <RowDefinition Height="*"/>
            <!-- 3. Authentication GroupBox (Step 2) -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Wizard Header -->
        <ctrl:WizardHeader x:Name="WizardHeaderControl" Grid.Row="0" Margin="0,0,0,14"/>

        <!-- ================= STEP 1: TIME SETTINGS FORM ================= -->
        <Grid x:Name="Step1Panel" Grid.Row="1" Margin="4,0,4,8" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- GroupBox: Time Zone & DST -->
            <GroupBox Grid.Row="0" Header="Time Zone &amp; Daylight Saving Time" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,10">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time Zone:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource ClassicComboBox}" SelectedIndex="0">
                        <ComboBoxItem Content="(GMT+01:00) Amsterdam, Berlin, Bern, Rome, Stockholm, Vienna"/>
                        <ComboBoxItem Content="(GMT+02:00) Athens, Bucharest, Istanbul, Helsinki, Kyiv"/>
                        <ComboBoxItem Content="(GMT+03:00) Moscow, St. Petersburg, Volgograd, Baghdad"/>
                        <ComboBoxItem Content="(GMT+00:00) Greenwich Mean Time : Dublin, Edinburgh, Lisbon, London"/>
                        <ComboBoxItem Content="(GMT-05:00) Eastern Time (US &amp; Canada)"/>
                        <ComboBoxItem Content="(GMT-08:00) Pacific Time (US &amp; Canada)"/>
                        <ComboBoxItem Content="(GMT+08:00) Beijing, Chongqing, Hong Kong, Singapore"/>
                        <ComboBoxItem Content="(GMT+09:00) Osaka, Sapporo, Tokyo, Seoul"/>
                    </ComboBox>

                    <CheckBox Grid.Row="1" Grid.Column="1"
                              Content="Automatically adjust clock for Daylight Saving Time (DST)"
                              IsChecked="False"
                              Style="{DynamicResource ClassicCheckBox}"
                              Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <!-- GroupBox: Synchronization Source -->
            <GroupBox Grid.Row="1" Header="System Time Synchronization" Style="{DynamicResource ClassicGroupBox}" Margin="0,0,0,10">
                <StackPanel Margin="8,6">
                    <!-- Option 1: SNTP -->
                    <RadioButton x:Name="RadioSntp"
                                 Content="Synchronize with Network Time Protocol (NTP / SNTP Server)"
                                 IsChecked="True"
                                 GroupName="TimeSyncMode"
                                 Style="{StaticResource ClassicRadioButton}"
                                 Margin="0,0,0,8"
                                 Checked="OnTimeModeChanged"/>

                    <Grid Margin="20,0,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Primary NTP Server:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="0.de.pool.ntp.org" Style="{DynamicResource ClassicTextBox}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Poll Interval:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="4" Style="{DynamicResource ClassicComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="1 hour (Default)"/>
                            <ComboBoxItem Content="6 hours"/>
                            <ComboBoxItem Content="12 hours"/>
                            <ComboBoxItem Content="24 hours"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Secondary Server:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="time.nist.gov" Style="{DynamicResource ClassicTextBox}"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="SNTP Port:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="123 (UDP)" IsEnabled="False" Style="{DynamicResource ClassicTextBox}"/>
                    </Grid>

                    <!-- Option 2: Manual -->
                    <RadioButton x:Name="RadioManual"
                                 Content="Set Date and Time Manually"
                                 GroupName="TimeSyncMode"
                                 Style="{StaticResource ClassicRadioButton}"
                                 Margin="0,4,0,6"
                                 Checked="OnTimeModeChanged"/>

                    <Grid Margin="20,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Date (YYYY-MM-DD):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtManualDate" Grid.Column="1" Text="2026-09-28" IsEnabled="False" Style="{DynamicResource ClassicTextBox}"/>

                        <TextBlock Grid.Column="3" Text="Time (HH:MM):" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtManualTime" Grid.Column="4" Text="12:00:00" IsEnabled="False" Style="{DynamicResource ClassicTextBox}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- GroupBox: Target Device Info -->
            <GroupBox Grid.Row="2" Header="Target Selection" Style="{DynamicResource ClassicGroupBox}">
                <StackPanel Margin="8,6">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Rectangle Width="14" Height="14" Fill="{DynamicResource IconDeviceSettings}" Margin="0,0,6,0"/>
                        <TextBlock Text="Target Device: DGS-1210-20/C1 (1C:5F:2B:73:47:B0)" FontWeight="SemiBold" Foreground="{DynamicResource ClassicTextTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Click 'Next >' to review synchronization parameters and authenticate changes." Foreground="{DynamicResource ClassicTextMuted}" Margin="20,0,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ================= STEP 2: CONFIRM SUMMARY ================= -->
        <Grid x:Name="Step2Panel" Grid.Row="1" Margin="4,0,4,8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <!-- Parameters form -->
                <RowDefinition Height="Auto"/>
                <!-- Section Header "Apply to All Devices" -->
                <RowDefinition Height="Auto"/>
                <!-- Device list grid -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Parameters Grid -->
            <Grid Grid.Row="0" Margin="6,0,6,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Left Column -->
                <!-- Time Zone -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Time Zone"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="(GMT+01:00) Amsterdam, Berlin, Rome"
                           Foreground="{DynamicResource ClassicTextBody}"
                           VerticalAlignment="Center"/>

                <!-- Daylight Saving Time -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Use Daylight Saving Time"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="Disabled"
                           Foreground="{DynamicResource ClassicTextBody}"
                           VerticalAlignment="Center"/>

                <!-- Right Column -->
                <!-- NTP/SNTP Server -->
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="NTP/SNTP Server"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="(DomainName) 0.de.pool.ntp.org"
                           Foreground="{DynamicResource ClassicTextBody}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- "Apply to All Devices" Header Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ClassicSubHeaderBackground}"
                    BorderBrush="{DynamicResource ClassicSubHeaderBorder}"
                    BorderThickness="1,1,1,0"
                    Padding="8,5">
                <TextBlock Text="Apply to All Devices"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ClassicTextTitle}"/>
            </Border>

            <!-- Table of Devices for Time Settings -->
            <DataGrid x:Name="WizardDataGrid"
                      Grid.Row="2"
                      Style="{DynamicResource ClassicDataGrid}"
                      BorderThickness="1"
                      MinHeight="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IsSupported" Binding="{Binding IsSupported}" Width="80"/>
                    <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="130"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150"/>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="110"/>
                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 3. Authentication GroupBox (Step 2) -->
        <GroupBox x:Name="AuthGroupBox"
                  Grid.Row="2"
                  Header="Authentication"
                  Style="{DynamicResource ClassicGroupBox}"
                  Margin="4,4,4,12"
                  Visibility="Collapsed">
            <Grid Margin="10,6,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- User Name -->
                <TextBlock Grid.Column="0"
                           Text="User Name"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox Grid.Column="1"
                         Text="admin"
                         Style="{DynamicResource ClassicTextBox}"/>

                <!-- Password -->
                <TextBlock Grid.Column="3"
                           Text="Password"
                           Foreground="{DynamicResource ClassicTextTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <PasswordBox Grid.Column="4"
                             x:Name="PwdBox"
                             Style="{StaticResource ClassicPasswordBox}"/>
            </Grid>
        </GroupBox>

        <!-- 4. Action Buttons -->
        <Grid Grid.Row="3" Margin="0,4,4,0">
            <!-- Left Side status / step hint -->
            <TextBlock x:Name="TxtStepHint"
                       Text="Step 1 of 2: Configure System Clock &amp; NTP Source"
                       Foreground="{DynamicResource ClassicTextMuted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,0"/>

            <!-- Right Side Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Previous Button (Shown on Step 2) -->
                <Button x:Name="BtnPrevious"
                        Content="&lt; Previous"
                        Style="{DynamicResource ClassicStandardButton}"
                        Click="OnPreviousClicked"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"/>

                <!-- Next Button (Shown on Step 1) -->
                <Button x:Name="BtnNext"
                        Content="Next &gt;"
                        Style="{DynamicResource ClassicDefaultButton}"
                        Click="OnNextClicked"
                        Margin="0,0,8,0"
                        Visibility="Visible"/>

                <!-- Submit Button (Shown on Step 2) -->
                <Button x:Name="BtnSubmit"
                        Content="Submit"
                        Style="{DynamicResource ClassicDefaultButton}"
                        Click="OnSubmitClicked"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"/>

                <!-- Cancel Button -->
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Style="{DynamicResource ClassicStandardButton}"
                        Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
