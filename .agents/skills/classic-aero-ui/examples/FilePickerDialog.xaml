<Window x:Class="ClassicAeroStudio.Views.FilePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Configuration or Firmware File"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="420" Width="580"
        MinHeight="390" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource ClassicCanvasBackground}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Breadcrumb & Path bar -->
            <RowDefinition Height="36"/>
            <!-- 2. Main File List / Tree Area -->
            <RowDefinition Height="*"/>
            <!-- 3. File Name & Filter Bar -->
            <RowDefinition Height="74"/>
            <!-- 4. Footer Action Bar -->
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Breadcrumb Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource ClassicSubHeaderBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Computer" Click="OnBreadcrumbClicked"/>
                    <TextBlock Text="›" Foreground="#888888" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Local Disk (C:)" Click="OnBreadcrumbClicked"/>
                    <TextBlock Text="›" Foreground="#888888" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="NetworkBackups" Click="OnBreadcrumbClicked"/>
                    <TextBlock Text="›" Foreground="#888888" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Style="{DynamicResource ClassicBreadcrumbButton}" Content="Firmware_v4" FontWeight="SemiBold" Click="OnBreadcrumbClicked"/>
                </StackPanel>

                <!-- Search inside folder -->
                <TextBox Grid.Column="2" Style="{DynamicResource ClassicSearchBox}" Width="150" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2. Main File Explorer Body: Left Sidebar TreeView + Right File ListBox -->
        <Grid Grid.Row="1" Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Quick Access Navigation Pane (Full Pure White Panel) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ClassicCardBackground}"
                    BorderBrush="{DynamicResource ClassicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header banner -->
                        <RowDefinition Height="24"/>
                        <!-- TreeView filling entire remaining area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource ClassicInnerBackground}"
                            BorderBrush="{DynamicResource ClassicDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="13" Height="13" Fill="{DynamicResource IconFolder}" Margin="0,0,5,0"/>
                            <TextBlock Text="Quick Access"
                                       FontFamily="Segoe UI"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ClassicTextTitle}"/>
                        </StackPanel>
                    </Border>

                    <TreeView Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4,4,4,4"
                              Style="{DynamicResource ClassicTreeView}">
                        <TreeViewItem Header="Favorites" IsExpanded="True" Style="{DynamicResource ClassicTreeViewItem}">
                            <TreeViewItem Header="Desktop" Style="{DynamicResource ClassicTreeViewItem}"/>
                            <TreeViewItem Header="Downloads" Style="{DynamicResource ClassicTreeViewItem}"/>
                            <TreeViewItem Header="NetworkBackups" IsSelected="True" Style="{DynamicResource ClassicTreeViewItem}"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Computer" IsExpanded="True" Style="{DynamicResource ClassicTreeViewItem}">
                            <TreeViewItem Header="Local Disk (C:)" Style="{DynamicResource ClassicTreeViewItem}"/>
                            <TreeViewItem Header="USB Drive (E:)" Style="{DynamicResource ClassicTreeViewItem}"/>
                        </TreeViewItem>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Resizable Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- Right File List Pane (Full Pure White Panel) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ClassicCardBackground}"
                    BorderBrush="{DynamicResource ClassicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header banner -->
                        <RowDefinition Height="24"/>
                        <!-- File List filling entire remaining area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource ClassicInnerBackground}"
                            BorderBrush="{DynamicResource ClassicDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="13" Height="13" Fill="{DynamicResource IconFolder}" Margin="0,0,5,0"/>
                                <TextBlock Text="Folder Contents (Firmware_v4)"
                                           FontFamily="Segoe UI"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ClassicTextTitle}"/>
                            </StackPanel>
                            <TextBlock Text="4 items"
                                       HorizontalAlignment="Right"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       Foreground="{DynamicResource ClassicTextSubtitle}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             x:Name="FileListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="2"
                             SelectionChanged="OnFileSelected">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFile}" Margin="0,0,6,0"/>
                                <TextBlock Text="DGS-1510-28X_RunConfig_20260928.cfg" VerticalAlignment="Center"/>
                                <TextBlock Text="  [14.2 KB]" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem IsSelected="True">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFirmwareUpgrade}" Margin="0,0,6,0"/>
                                <TextBlock Text="DGS-1210-28P_Firmware_v4.21.B012.bin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="  [18.6 MB]" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFile}" Margin="0,0,6,0"/>
                                <TextBlock Text="DAP-2660_FactoryDefault_Backup.bin" VerticalAlignment="Center"/>
                                <TextBlock Text="  [8.1 MB]" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Rectangle Width="14" Height="14" Fill="{DynamicResource IconFile}" Margin="0,0,6,0"/>
                                <TextBlock Text="Syslog_AuditReport_2026_Q3.log" VerticalAlignment="Center"/>
                                <TextBlock Text="  [512 KB]" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. File Name & Filter Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource ClassicCanvasBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <!-- File Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="File name:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}" FontWeight="SemiBold"/>
                <TextBox x:Name="FileNameBox" Grid.Row="0" Grid.Column="1" Text="DGS-1210-28P_Firmware_v4.21.B012.bin" Height="22" VerticalAlignment="Center"/>

                <!-- File Filter -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Files of type:" VerticalAlignment="Center" Foreground="{DynamicResource ClassicTextTitle}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="22" SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Firmware Image &amp; Config Files (*.bin; *.cfg; *.tar.gz)"/>
                    <ComboBoxItem Content="Configuration Script Files (*.cfg; *.txt)"/>
                    <ComboBoxItem Content="All Files (*.*)"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 4. Footer Action Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource ClassicCanvasBackground}"
                BorderBrush="{DynamicResource ClassicDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0"
                Height="46"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Target: Flash Memory (Bank 1)"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Open / Select"
                            Style="{DynamicResource ClassicDefaultButton}"
                            IsDefault="True"
                            Width="96" Height="24"
                            Margin="0,0,8,0"
                            Click="OnOpenClicked"/>

                    <Button Content="Cancel"
                            Style="{DynamicResource ClassicStandardButton}"
                            IsCancel="True"
                            Width="75" Height="24"
                            Click="OnCancelClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
