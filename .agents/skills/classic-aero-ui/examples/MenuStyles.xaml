<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- CLASSIC WINDOWS 7 / AERO MENU & CONTEXTMENU SYSTEM                -->
    <!-- Authentic Windows 7 menu with flush, mathematically-centered icon -->
    <!-- gutter, hover gradients, and crisp ClearType text.                -->
    <!-- ================================================================= -->

    <!-- Menu Separator Style -->
    <Style x:Key="ClassicMenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border BorderThickness="1,0,1,0" BorderBrush="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid Height="3" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <!-- Gutter Column: exactly 27px, matching MenuItem gutter placement -->
                                <ColumnDefinition Width="27"/>
                                <!-- Content Column -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Gutter background in Column 0 with 1px right border -->
                            <Border Grid.Column="0"
                                    Background="#F1F4F8"
                                    BorderBrush="#DFE7F0"
                                    BorderThickness="0,0,1,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                            <!-- Single 1px separator line in Column 1, mathematically centered at Y=1 in 3px height (1px top gap, 1px bottom gap) -->
                            <Rectangle Grid.Column="1"
                                       Height="1"
                                       Fill="#DFE7F0"
                                       VerticalAlignment="Center"
                                       Margin="2,0,2,0"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top-Level Header MenuItem Template for Menu Bar -->
    <ControlTemplate x:Key="ClassicTopLevelHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="itemBorder"
                BorderThickness="1"
                BorderBrush="Transparent"
                Background="Transparent"
                CornerRadius="2"
                Padding="6,2,6,2"
                Margin="1,1"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Grid>
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="False"
                       IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Fade">
                    <Border Background="#FCFDFE"
                            BorderBrush="#859EB8"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,1,0,1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ScrollViewer CanContentScroll="True" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#E6F1FC" Offset="0.5"/>
                            <GradientStop Color="#CCE4F9" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#70A8DE"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="itemBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EBF4FD" Offset="0"/>
                            <GradientStop Color="#D6E8F8" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#6292C4"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#90A2B4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- MenuItem Style -->
    <Style x:Key="ClassicMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="itemBorder"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Icon Gutter Column: exactly 27px wide (5px left + 16px icon + 5px right + 1px border) -->
                                <ColumnDefinition Width="27"/>
                                <!-- Header / Title Column -->
                                <ColumnDefinition Width="*"/>
                                <!-- Input Gesture Text (Shortcut) Column -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutGroup"/>
                                <!-- Submenu Arrow Column -->
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <!-- Gutter Background & Icon Container:
                                 Total 27px. 1px right border -> 26px inner space.
                                 16px icon centered in 26px space -> 5px left, 5px right. Completely symmetrical! -->
                            <Border x:Name="gutterBorder"
                                    Grid.Column="0"
                                    Background="#F1F4F8"
                                    BorderBrush="#DFE7F0"
                                    BorderThickness="0,0,1,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter ContentSource="Icon"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Width="16" Height="16"
                                                  SnapsToDevicePixels="True"
                                                  UseLayoutRounding="True"/>
                            </Border>

                            <!-- Header Text -->
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="8,0,16,0"
                                              SnapsToDevicePixels="True"/>

                            <!-- Shortcut Text (e.g. Ctrl+S) -->
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="#647B95"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"/>

                            <!-- Submenu Chevron Arrow -->
                            <Path x:Name="RightArrow"
                                  Grid.Column="3"
                                  Data="M 0,0 L 4,3.5 L 0,7 Z"
                                  Fill="#3E5C7B"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>

                            <!-- Popup for submenus -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="#FCFDFE"
                                        BorderBrush="#859EB8"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="0,1,0,1"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <ScrollViewer CanContentScroll="True" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    Grid.IsSharedSizeScope="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Hover State (Classic Windows 7 Soft Blue Gradient & Border across entire item) -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E6F1FC" Offset="0.5"/>
                                        <GradientStop Color="#CCE4F9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#70A8DE"/>
                            <!-- In hover state, make the gutter border transparent so the gradient flows seamlessly -->
                            <Setter TargetName="gutterBorder" Property="Background" Value="Transparent"/>
                            <Setter TargetName="gutterBorder" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#90A2B4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource ClassicTopLevelHeaderTemplate}"/>
                <Setter Property="Height" Value="22"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource ClassicTopLevelHeaderTemplate}"/>
                <Setter Property="Height" Value="22"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Classic Menu Bar Style -->
    <Style x:Key="ClassicMenu" TargetType="Menu">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FCFDFE" Offset="0.0"/>
                    <GradientStop Color="#F0F4F8" Offset="0.5"/>
                    <GradientStop Color="#E4EBF2" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#D0DFEE"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="2,0"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic ContextMenu Style -->
    <Style x:Key="ClassicContextMenu" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- Flush zero-margin on left so gutter touches outer border seamlessly -->
                    <Border Background="#F9FAFC"
                            BorderBrush="#7795B5"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,2,0,2"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit styles -->
    <Style TargetType="Menu" BasedOn="{StaticResource ClassicMenu}"/>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource ClassicContextMenu}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource ClassicMenuItem}"/>
    <Style TargetType="Separator" BasedOn="{StaticResource ClassicMenuSeparator}"/>

</ResourceDictionary>
