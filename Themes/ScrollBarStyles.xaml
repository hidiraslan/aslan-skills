<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- SLEEK THIN AERO SCROLLBAR SYSTEM (8px Thin Track & Glass Thumb)   -->
    <!-- Compact, elegant, never eats valuable screen real estate.          -->
    <!-- ================================================================= -->

    <!-- ScrollBar Page RepeatButton Style (Transparent Track click area) -->
    <Style x:Key="ClassicScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}"
                               Height="{TemplateBinding Height}"
                               Width="{TemplateBinding Width}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sleek Thin Thumb Style -->
    <Style x:Key="ClassicScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder"
                            BorderBrush="#8AAECF"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#BFD4E8"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#5588BD"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#95BDDF"/>
                        </Trigger>
                        <!-- Pressed / Dragging State -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#2B6DAE"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#6EA1CE"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#E6E6E6"/>
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main Sleek Thin ScrollBar Style (9px wide / 9px high) -->
    <Style x:Key="ClassicScrollBar" TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#F2F5F9"/>
        <Style.Triggers>
            <!-- Vertical ScrollBar (9px width) -->
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="9"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ClassicScrollBarThumb}"
                                               Margin="1,2,1,2"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <!-- Horizontal ScrollBar (9px height) -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ClassicScrollBarThumb}"
                                               Margin="2,1,2,1"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default implicit style so any ScrollBar automatically uses this thin sleek design -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ClassicScrollBar}"/>

    <!-- Global Aero ScrollViewer Touch & Pan Integration (Enables Direct Finger Dragging / Momentum Scrolling on Touch Screens) -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="Both"/>
        <Setter Property="PanningRatio" Value="1"/>
        <Setter Property="PanningDeceleration" Value="0.001"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

</ResourceDictionary>
