<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Classic Windows 7 Dialog Button Style (e.g. Previous, Submit) -->
    <Style x:Key="ClassicStandardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#707070"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#F0F0F0">
                        <Grid>
                            <!-- Inner bevel / gradient -->
                            <Border x:Name="innerGlow"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F3F3F3" Offset="0.0"/>
                                        <GradientStop Color="#EBEBEB" Offset="0.45"/>
                                        <GradientStop Color="#DDDDDD" Offset="0.5"/>
                                        <GradientStop Color="#CDCDCD" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State: Classic Windows 7 subtle light blue glow -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3C7FB1"/>
                            <Setter TargetName="innerGlow" Property="BorderBrush" Value="#FAFCFD"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EAF6FD" Offset="0.0"/>
                                        <GradientStop Color="#D9F0FC" Offset="0.45"/>
                                        <GradientStop Color="#BEE6FD" Offset="0.5"/>
                                        <GradientStop Color="#A7D9F5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Pressed State -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2C628B"/>
                            <Setter TargetName="innerGlow" Property="BorderBrush" Value="#C2E4F6"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C4E5F6" Offset="0.0"/>
                                        <GradientStop Color="#98D1EF" Offset="0.45"/>
                                        <GradientStop Color="#68B3DB" Offset="0.5"/>
                                        <GradientStop Color="#2C89B5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#BFBFBF"/>
                            <Setter TargetName="innerGlow" Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter TargetName="innerGlow" Property="Background" Value="#F4F4F4"/>
                            <Setter Property="Foreground" Value="#838383"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default Primary Dialog Button Style (e.g. Submit button with subtle blue border) -->
    <Style x:Key="ClassicDefaultButton" TargetType="Button" BasedOn="{StaticResource ClassicStandardButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#2A73AC"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#F0F0F0">
                        <Grid>
                            <Border x:Name="innerGlow"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EBF4FB" Offset="0.0"/>
                                        <GradientStop Color="#DCEDF9" Offset="0.45"/>
                                        <GradientStop Color="#C4E0F5" Offset="0.5"/>
                                        <GradientStop Color="#AFD4F0" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1C66A0"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E5F3FC" Offset="0.0"/>
                                        <GradientStop Color="#CDE8F9" Offset="0.45"/>
                                        <GradientStop Color="#A2D2F2" Offset="0.5"/>
                                        <GradientStop Color="#85C1EB" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#104D7C"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B9DCF4" Offset="0.0"/>
                                        <GradientStop Color="#86BFE6" Offset="0.45"/>
                                        <GradientStop Color="#539FD4" Offset="0.5"/>
                                        <GradientStop Color="#287EBA" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top Left Blue Application Pill Button (Windows 7 / Wordpad ribbon style) -->
    <Style x:Key="ClassicAppPillButton" TargetType="Button">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#064E88"
                            BorderThickness="1"
                            CornerRadius="2,2,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1E80CF" Offset="0.0"/>
                                <GradientStop Color="#1167AC" Offset="0.45"/>
                                <GradientStop Color="#0D538E" Offset="0.5"/>
                                <GradientStop Color="#073B66" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <!-- Inner soft highlight -->
                            <Border BorderBrush="#6AB2EA" BorderThickness="1,1,1,0" CornerRadius="1,1,0,0" Opacity="0.5"/>
                            <!-- Small white triangle pointing down -->
                            <Path HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="#FFFFFF"
                                  Data="M 0,0 L 7,0 L 3.5,4 Z"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#0862AA"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2B94E6" Offset="0.0"/>
                                        <GradientStop Color="#177BCB" Offset="0.45"/>
                                        <GradientStop Color="#1068AD" Offset="0.5"/>
                                        <GradientStop Color="#0B4B7E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0F578F" Offset="0.0"/>
                                        <GradientStop Color="#084270" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic Aero Theme Switch Pill Switch (Light Mode: Sun active on Left) -->
    <Style x:Key="ClassicThemeTogglePill" TargetType="Button">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 1. Outer Pill Track -->
                    <Border x:Name="track"
                            Width="56" Height="22"
                            CornerRadius="11"
                            BorderBrush="#8AA7C6"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CAD6E2" Offset="0.0"/>
                                <GradientStop Color="#DBE5EE" Offset="0.4"/>
                                <GradientStop Color="#E9F0F7" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <!-- 2. Active Sliding Knob (Left: Sun active) -->
                            <Border x:Name="knob"
                                    Width="26" Height="18"
                                    CornerRadius="9"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0"
                                    BorderBrush="#779CBE"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#F3F7FB" Offset="0.45"/>
                                        <GradientStop Color="#DDE9F5" Offset="0.5"/>
                                        <GradientStop Color="#CFE1F2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 3. Two Slots Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon: Sun (Active, Warm Amber) -->
                                <Canvas Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Canvas.Left="4" Canvas.Top="4"
                                             Fill="#FFB300" Stroke="#D97706" StrokeThickness="0.8"/>
                                    <Path Stroke="#D97706" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 7,0.5 L 7,2.5 M 7,11.5 L 7,13.5 M 0.5,7 L 2.5,7 M 11.5,7 L 13.5,7 M 2.4,2.4 L 3.8,3.8 M 10.2,10.2 L 11.6,11.6 M 2.4,11.6 L 3.8,10.2 M 10.2,3.8 L 11.6,2.4"/>
                                </Canvas>

                                <!-- Right Icon: Moon (Inactive, Muted Slate) -->
                                <Path Grid.Column="1" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Data="M 9,1 A 5.5,5.5 0 1 0 9,11 A 4.2,4.2 0 0 1 9,1 Z"
                                      Fill="#7C93AA" Stroke="#677E95" StrokeThickness="0.6"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#4C8BC5"/>
                            <Setter TargetName="knob" Property="BorderBrush" Value="#3C7FB1"/>
                            <Setter TargetName="knob" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#E3F0FD" Offset="0.45"/>
                                        <GradientStop Color="#C8E2FA" Offset="0.5"/>
                                        <GradientStop Color="#B4D7F7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="knob" Property="BorderBrush" Value="#1F5B8B"/>
                            <Setter TargetName="knob" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C0DAF3" Offset="0.0"/>
                                        <GradientStop Color="#D2E6F8" Offset="0.5"/>
                                        <GradientStop Color="#B8D7F3" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic Windows Ribbon Large Tool Button Style -->
    <Style x:Key="ClassicRibbonButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="2,1,2,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="outerBorder"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            Padding="2,3,2,3"
                            SnapsToDevicePixels="True">
                        <Border x:Name="innerBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Classic Windows 7 ribbon distinct card with clearly visible borders on all 4 sides -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#6599CE"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FCFDFF" Offset="0.0"/>
                                        <GradientStop Color="#EEF5FD" Offset="0.5"/>
                                        <GradientStop Color="#D6E7FA" Offset="0.51"/>
                                        <GradientStop Color="#E6F1FC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B77B5"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#B2D0F5"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#CFE2F8" Offset="0.0"/>
                                        <GradientStop Color="#BDD8F7" Offset="0.5"/>
                                        <GradientStop Color="#9EC5F1" Offset="0.51"/>
                                        <GradientStop Color="#B7D4F7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Foreground" Value="#838383"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic Small Toolbar Button (e.g. Refresh button) -->
    <Style x:Key="ClassicSmallToolButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#B5C7DE"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FDFEFE" Offset="0.0"/>
                                <GradientStop Color="#EDF3FA" Offset="0.5"/>
                                <GradientStop Color="#DFEAF7" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#7FA4CE"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#E3EFFC" Offset="0.5"/>
                                        <GradientStop Color="#C9E0F8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#547DA9"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B8D7F7" Offset="0.0"/>
                                        <GradientStop Color="#96C2F2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- CLASSIC DATA GRID & LIST ROW ACTION BUTTONS (18PX PRECISE FIT)    -->
    <!-- Specifically crafted for 24px DataGrid rows and List items        -->
    <!-- Leaves 3px top/bottom margin, perfectly centered, never clipped   -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicRowButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="MaxHeight" Value="18"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#9BB5D0"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#EDF4FC" Offset="0.45"/>
                                <GradientStop Color="#DBE7F5" Offset="0.5"/>
                                <GradientStop Color="#CBDBEE" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#4C82B8"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#E6F2FE" Offset="0.45"/>
                                        <GradientStop Color="#CEE4FC" Offset="0.5"/>
                                        <GradientStop Color="#B3D4F8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2B5B8E"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A4CCF5" Offset="0.0"/>
                                        <GradientStop Color="#7FB5EE" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#D0D0D0"/>
                            <Setter TargetName="border" Property="Background" Value="#F4F4F4"/>
                            <Setter Property="Foreground" Value="#8A8A8A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-Only Row Tool Button (e.g. 20x18 compact tool button) -->
    <Style x:Key="ClassicRowIconButton" TargetType="Button" BasedOn="{StaticResource ClassicRowButton}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Danger/Delete Row Button (Red Aero gradient) -->
    <Style x:Key="ClassicRowButtonDanger" TargetType="Button" BasedOn="{StaticResource ClassicRowButton}">
        <Setter Property="Foreground" Value="#900C0C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#D59A9A"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#FDF0F0" Offset="0.45"/>
                                <GradientStop Color="#FBE2E2" Offset="0.5"/>
                                <GradientStop Color="#F6CDCD" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#C24E4E"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#FDE8E8" Offset="0.45"/>
                                        <GradientStop Color="#F8CECE" Offset="0.5"/>
                                        <GradientStop Color="#EFA8A8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#8E2020"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E68A8A" Offset="0.0"/>
                                        <GradientStop Color="#D46060" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic Small / Compact Toolbar Button Style (Alias for ClassicSmallToolButton) -->
    <Style x:Key="ClassicToolbarButton" TargetType="Button" BasedOn="{StaticResource ClassicSmallToolButton}"/>

    <!-- Classic Windows Ribbon Toggle Button Style (Checkable Ribbon Tool) -->
    <Style x:Key="ClassicRibbonToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="2,1,2,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="outerBorder"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            Padding="2,3,2,3"
                            SnapsToDevicePixels="True">
                        <Border x:Name="innerBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#6599CE"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FCFDFF" Offset="0.0"/>
                                        <GradientStop Color="#EEF5FD" Offset="0.5"/>
                                        <GradientStop Color="#D6E7FA" Offset="0.51"/>
                                        <GradientStop Color="#E6F1FC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Pressed State -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B77B5"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#B2D0F5"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#CFE2F8" Offset="0.0"/>
                                        <GradientStop Color="#BDD8F7" Offset="0.5"/>
                                        <GradientStop Color="#9EC5F1" Offset="0.51"/>
                                        <GradientStop Color="#B7D4F7" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Checked / Toggled State (Sunken Active Aero Blue) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#296294"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#A4C7EF"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#BFD8F5" Offset="0.0"/>
                                        <GradientStop Color="#A2C6EE" Offset="0.5"/>
                                        <GradientStop Color="#85B3E6" Offset="0.51"/>
                                        <GradientStop Color="#9FC5EE" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Checked and MouseOver -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#1C5384"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C9E0FA" Offset="0.0"/>
                                        <GradientStop Color="#B2D3F5" Offset="0.5"/>
                                        <GradientStop Color="#96BFEF" Offset="0.51"/>
                                        <GradientStop Color="#ACD0F5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

