    <!-- Horizontal Slider Template (Light) -->
    <ControlTemplate x:Key="ClassicSliderHorizontalTemplate" TargetType="Slider">
        <Grid VerticalAlignment="Center">
            <Border Height="4"
                    VerticalAlignment="Center"
                    Background="#E6ECF2"
                    BorderBrush="#8B9EB5"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ClassicSliderTrackRepeatButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ClassicSliderTrackRepeatButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ClassicSliderThumbHorizontal}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Vertical Slider Template (Light) -->
    <ControlTemplate x:Key="ClassicSliderVerticalTemplate" TargetType="Slider">
        <Grid HorizontalAlignment="Center">
            <Border Width="4"
                    HorizontalAlignment="Center"
                    Background="#E6ECF2"
                    BorderBrush="#8B9EB5"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ClassicSliderTrackRepeatButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ClassicSliderTrackRepeatButton}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ClassicSliderThumbVertical}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Classic Windows 7 Slider Style (Responsive Horizontal & Vertical) -->
    <Style x:Key="ClassicSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource ClassicSliderHorizontalTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="22"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Template" Value="{StaticResource ClassicSliderVerticalTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
