<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Classic Windows 7 ProgressBar Style (Vibrant green Aero gradient - Default) -->
    <Style x:Key="ClassicProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#8B9EB5"/>
        <Setter Property="Background" Value="#E6ECF2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Track Background -->
                        <Border x:Name="Track"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#DEE5EC" Offset="0.0"/>
                                    <GradientStop Color="#EFF4F8" Offset="0.5"/>
                                    <GradientStop Color="#F6FAFC" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Progress Bar Fill Indicator (Green) -->
                        <Border x:Name="PART_Track" Margin="1">
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border BorderBrush="#1C7D10" BorderThickness="0.8" CornerRadius="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#9AEF4E" Offset="0.0"/>
                                            <GradientStop Color="#40D622" Offset="0.45"/>
                                            <GradientStop Color="#24B812" Offset="0.5"/>
                                            <GradientStop Color="#1A9308" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <!-- Glossy top reflection -->
                                    <Rectangle Height="6" VerticalAlignment="Top">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#70FFFFFF" Offset="0"/>
                                                <GradientStop Color="#10FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>
                            </Decorator>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

