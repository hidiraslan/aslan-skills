    <!-- Dark Aero ProgressBars -->
    <Style x:Key="ClassicProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="Background" Value="#181D24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#14181F" Offset="0.0"/>
                                    <GradientStop Color="#1E242D" Offset="0.5"/>
                                    <GradientStop Color="#242B36" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border x:Name="PART_Track" Margin="1">
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border BorderBrush="#1C7D10" BorderThickness="0.8" CornerRadius="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7CDA36" Offset="0.0"/>
                                            <GradientStop Color="#30B816" Offset="0.45"/>
                                            <GradientStop Color="#1C9E0C" Offset="0.5"/>
                                            <GradientStop Color="#147E08" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Rectangle Height="6" VerticalAlignment="Top">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#50FFFFFF" Offset="0"/>
                                                <GradientStop Color="#08FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>
                            </Decorator>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

