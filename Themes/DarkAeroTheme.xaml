    <SolidColorBrush x:Key="ClassicCodeGutterForeground" Color="#5A6D82"/>
    <SolidColorBrush x:Key="ClassicCodeEditorBackground" Color="#12161C"/>
    <SolidColorBrush x:Key="ClassicCodeKeyword" Color="#569CD6"/>
    <SolidColorBrush x:Key="ClassicCodeKeywordAlt" Color="#C586C0"/>
    <SolidColorBrush x:Key="ClassicCodeFunction" Color="#DCDCAA"/>
    <SolidColorBrush x:Key="ClassicCodeString" Color="#CE9178"/>
    <SolidColorBrush x:Key="ClassicCodeComment" Color="#6A9955"/>
    <SolidColorBrush x:Key="ClassicCodeNumber" Color="#B5CEA8"/>
    <SolidColorBrush x:Key="ClassicCodeIdentifier" Color="#9CDCFE"/>
    <SolidColorBrush x:Key="ClassicCodeProperty" Color="#4EC9B0"/>

    <!-- Dark Aero Top Header Gradient -->
    <LinearGradientBrush x:Key="ClassicTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C3440" Offset="0.0"/>
        <GradientStop Color="#232A33" Offset="0.5"/>
        <GradientStop Color="#1D232B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!-- 1. DARK AERO BUTTONS (Steel & Obsidian Bevels)                    -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicStandardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="TextElement.Foreground" Value="#E2ECF8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#485669"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#222832"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="innerGlow"
                                    BorderBrush="#3D4A5B"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#36404E" Offset="0.0"/>
                                        <GradientStop Color="#28303B" Offset="0.45"/>
                                        <GradientStop Color="#1F252E" Offset="0.5"/>
                                        <GradientStop Color="#1A1F26" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="innerGlow" Property="BorderBrush" Value="#4B6A8E"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#425062" Offset="0.0"/>
                                        <GradientStop Color="#303C4B" Offset="0.45"/>
                                        <GradientStop Color="#242E3B" Offset="0.5"/>
                                        <GradientStop Color="#1E2733" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5A96"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#161C24" Offset="0.0"/>
                                        <GradientStop Color="#222A36" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2D3540"/>
                            <Setter TargetName="innerGlow" Property="Background" Value="#1C2128"/>
                            <Setter Property="Foreground" Value="#5A6878"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Deep Sapphire Aero Obsidian Blue) -->
    <Style x:Key="ClassicPrimaryButton" TargetType="Button" BasedOn="{StaticResource ClassicStandardButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#2A85D6"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="#186BB5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="innerGlow"
                                    BorderBrush="#54A5EB"
                                    BorderThickness="1"
                                    CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2881D2" Offset="0.0"/>
                                        <GradientStop Color="#176AB6" Offset="0.45"/>
                                        <GradientStop Color="#10579A" Offset="0.5"/>
                                        <GradientStop Color="#0B447A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#5CB5FF"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3692E6" Offset="0.0"/>
                                        <GradientStop Color="#1C77CC" Offset="0.45"/>
                                        <GradientStop Color="#1362AC" Offset="0.5"/>
                                        <GradientStop Color="#0E4E8E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#093C6C"/>
                            <Setter TargetName="innerGlow" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#0A3865" Offset="0.0"/>
                                        <GradientStop Color="#145A9E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicDefaultButton" TargetType="Button" BasedOn="{StaticResource ClassicPrimaryButton}"/>
    <Style x:Key="ClassicSecondaryButton" TargetType="Button" BasedOn="{StaticResource ClassicStandardButton}"/>

    <!-- Dark Aero Row Button (18px precise fit, zero clipping) -->
    <Style x:Key="ClassicRowButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="TextElement.Foreground" Value="#E2ECF8"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="MaxHeight" Value="18"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="#445366"
                            BorderThickness="1"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#303A47" Offset="0.0"/>
                                <GradientStop Color="#242B35" Offset="0.45"/>
                                <GradientStop Color="#1C222B" Offset="0.5"/>
                                <GradientStop Color="#171C23" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3B495A" Offset="0.0"/>
                                        <GradientStop Color="#2B3644" Offset="0.45"/>
                                        <GradientStop Color="#222B36" Offset="0.5"/>
                                        <GradientStop Color="#1B222C" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5A96"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#151A21" Offset="0.0"/>
                                        <GradientStop Color="#232C37" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2D3540"/>
                            <Setter TargetName="border" Property="Background" Value="#1A1F26"/>
                            <Setter Property="Foreground" Value="#5A6878"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicRowIconButton" TargetType="Button" BasedOn="{StaticResource ClassicRowButton}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="ClassicSmallToolButton" TargetType="Button" BasedOn="{StaticResource ClassicStandardButton}">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="MinWidth" Value="22"/>
    </Style>

    <Style x:Key="ClassicToolbarButton" TargetType="Button" BasedOn="{StaticResource ClassicSmallToolButton}"/>

    <!-- Dark Ribbon Band Container -->
    <Style x:Key="ClassicRibbonBandStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#28313D" Offset="0.0"/>
                    <GradientStop Color="#202731" Offset="0.3"/>
                    <GradientStop Color="#1A2028" Offset="0.7"/>
                    <GradientStop Color="#14181F" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Vertical Separator between Ribbon Groups -->
    <Style x:Key="RibbonGroupSeparator" TargetType="Separator">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Margin" Value="4,4,4,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Width="2" Height="{TemplateBinding Height}">
                        <Rectangle Width="1" HorizontalAlignment="Left" Fill="#181D24"/>
                        <Rectangle Width="1" HorizontalAlignment="Right" Fill="#3E4A5B"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Ribbon Large Button Style -->
    <Style x:Key="ClassicRibbonButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="2,1,2,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="outerBorder"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            Padding="2,3,2,3"
                            SnapsToDevicePixels="True">
                        <Border x:Name="innerBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#4B6A8E"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#364353" Offset="0.0"/>
                                        <GradientStop Color="#293442" Offset="0.5"/>
                                        <GradientStop Color="#1F2833" Offset="0.51"/>
                                        <GradientStop Color="#273240" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#1C5E96"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#254B70"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#182029" Offset="0.0"/>
                                        <GradientStop Color="#212C39" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Foreground" Value="#5A6878"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Ribbon Toggle Button Style -->
    <Style x:Key="ClassicRibbonToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="2,1,2,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="outerBorder"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            Padding="2,3,2,3"
                            SnapsToDevicePixels="True">
                        <Border x:Name="innerBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#4B6A8E"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#364353" Offset="0.0"/>
                                        <GradientStop Color="#293442" Offset="0.5"/>
                                        <GradientStop Color="#1F2833" Offset="0.51"/>
                                        <GradientStop Color="#273240" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#1C5E96"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#254B70"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#182029" Offset="0.0"/>
                                        <GradientStop Color="#212C39" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#2575B8"/>
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="#336B9C"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1E3E5E" Offset="0.0"/>
                                        <GradientStop Color="#16314D" Offset="0.5"/>
                                        <GradientStop Color="#11273F" Offset="0.51"/>
                                        <GradientStop Color="#183657" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B8ECC"/>
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#284B6F" Offset="0.0"/>
                                        <GradientStop Color="#1D3C5C" Offset="0.5"/>
                                        <GradientStop Color="#17314D" Offset="0.51"/>
                                        <GradientStop Color="#22446A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Ribbon Mini Button Style -->
    <Style x:Key="ClassicRibbonMiniButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="4,1,6,1"/>
        <Setter Property="Margin" Value="1,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="border" Property="Background" Value="#293544"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1C5E96"/>
                            <Setter TargetName="border" Property="Background" Value="#1B242F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- 2. DARK AERO FORM CONTROLS (TextBox, ComboBox, CheckBox, etc.)    -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#4C6078"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2D7ECC"/>
                            <Setter TargetName="border" Property="Background" Value="#181D23"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#15181E"/>
                            <Setter Property="Foreground" Value="#556475"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="CaretBrush" Value="#FFFFFF"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ClassicCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Cursor="Hand" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box"
                                Grid.Column="0"
                                Width="13" Height="13"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                BorderBrush="#4A586B"
                                BorderThickness="1"
                                CornerRadius="1"
                                Background="#1C222A"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="checkMark"
                                      Data="M 2.5,5.5 L 4.5,8.2 L 9.5,2.5"
                                      Stroke="#6EB2F0"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,1"/>
                                <Rectangle x:Name="indeterminateBox"
                                           Width="7" Height="7"
                                           Fill="#6EB2F0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter"
                                          Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="contentPresenter" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="indeterminateBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="box" Property="Background" Value="#242C37"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="box" Property="BorderBrush" Value="#333D4B"/>
                            <Setter TargetName="box" Property="Background" Value="#161B22"/>
                            <Setter TargetName="checkMark" Property="Stroke" Value="#556677"/>
                            <Setter TargetName="indeterminateBox" Property="Fill" Value="#556677"/>
                            <Setter Property="Foreground" Value="#667788"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ================================================================= -->
    <!-- 2. DARK AERO GROUPBOX (Single Crisp 1px Border, No 3D Double-Etch)-->
    <!-- ================================================================= -->
    <Style x:Key="ClassicGroupBox" TargetType="GroupBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#76A6D6"/>
        <Setter Property="BorderBrush" Value="#384556"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8,10,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top row: Left line segment, Header, Right line segment -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left corner & short top line before header -->
                            <Border Grid.Column="0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,0,0"
                                    CornerRadius="2,0,0,0"
                                    Margin="0,7,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>

                            <!-- Header content: transparent background, crisp single line -->
                            <Border Grid.Column="1"
                                    Padding="4,0,4,0"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>

                            <!-- Right top line & right corner after header -->
                            <Border Grid.Column="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,1,1,0"
                                    CornerRadius="0,2,0,0"
                                    Margin="0,7,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                        </Grid>

                        <!-- Bottom row: Left border, Bottom border, Right border + Inner Content -->
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,2,2"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- 3. DARK AERO DATAGRID & TABLES                                    -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="#3A4758"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="headerBorder"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#323B47" Offset="0.0"/>
                                    <GradientStop Color="#272F3A" Offset="0.45"/>
                                    <GradientStop Color="#1F252E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="headerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3D4856" Offset="0.0"/>
                                        <GradientStop Color="#2E3743" Offset="0.45"/>
                                        <GradientStop Color="#252D37" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicDataGridColumnHeaderCentered" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ClassicDataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ClassicDataGridCell" TargetType="DataGridCell">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border BorderThickness="0" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClassicDataGridCellCentered" TargetType="DataGridCell" BasedOn="{StaticResource ClassicDataGridCell}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ClassicDataGridRow" TargetType="DataGridRow">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#212730"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border"
                            BorderBrush="#2C3644"
                            BorderThickness="0,0,0,1"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <DataGridCellsPresenter Grid.Column="1" SnapsToDevicePixels="True"/>
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Dark Aero Sapphire Selection -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#186BB5" Offset="0.0"/>
                                        <GradientStop Color="#0E4B82" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="DGR_Border" Property="BorderBrush" Value="#2A85D6"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <!-- Hover on unselected -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="DGR_Border" Property="Background" Value="#293340"/>
                            <Setter TargetName="DGR_Border" Property="BorderBrush" Value="#3B82C4"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicDataGrid" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="#212730"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#2C3644"/>
        <Setter Property="VerticalGridLinesBrush" Value="#3A4758"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="ColumnHeaderHeight" Value="24"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ClassicDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource ClassicDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ClassicDataGridRow}"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ================================================================= -->
    <!-- 4. DARK AERO STATUS BAR                                           -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicStatusBar" TargetType="StatusBar">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#B5C7D9"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="#3A4758"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#252D37" Offset="0.0"/>
                    <GradientStop Color="#1D232A" Offset="0.5"/>
                    <GradientStop Color="#171C22" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicStatusBarSeparator" TargetType="Separator">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="6,0,6,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Width="2">
                        <Rectangle Width="1" HorizontalAlignment="Left" Fill="#2C3644"/>
                        <Rectangle Width="1" HorizontalAlignment="Right" Fill="#455468"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- 5. DARK AERO TREEVIEW & LISTBOX                                   -->
    <!-- ================================================================= -->
    <!-- Dark Aero TreeViewItem Expander Toggle Button -->
    <Style x:Key="ClassicTreeViewItemToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="16" Height="16" Background="Transparent">
                        <Path x:Name="ExpandPath"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="Transparent"
                              Stroke="#7690AB"
                              StrokeThickness="1"
                              Data="M 1,1.5 L 4.5,5 L 1,8.5 Z"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandPath" Property="Fill" Value="#7690AB"/>
                            <Setter TargetName="ExpandPath" Property="Data" Value="M 1,1 L 6.5,6.5 L 1,6.5 Z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ExpandPath" Property="Stroke" Value="#3B82C4"/>
                            <Setter TargetName="ExpandPath" Property="Fill" Value="#3B82C4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicTreeViewItem" TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Expander Glyph -->
                        <ToggleButton x:Name="Expander"
                                      Style="{StaticResource ClassicTreeViewItemToggle}"
                                      IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>

                        <!-- Header Area -->
                        <Border x:Name="Bd"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <!-- Children Items -->
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Column="1"
                                        Grid.Row="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#293340"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82C4"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#186BB5"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2A85D6"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#263A4D"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#35587A"/>
                            <Setter Property="Foreground" Value="#E2ECF8"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicTreeView" TargetType="TreeView">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicTreeViewItem}"/>
    </Style>

    <Style x:Key="ClassicListBoxItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="border" Property="Background" Value="#293340"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#2A85D6"/>
                            <Setter TargetName="border" Property="Background" Value="#186BB5"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicListBox" TargetType="ListBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="#212730"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicListBoxItem}"/>
    </Style>

    <!-- ================================================================= -->
    <!-- 7. DARK AERO TABS SYSTEM                                          -->
    <!-- ================================================================= -->
    <!-- Ribbon TabItem -->
    <Style x:Key="ClassicRibbonTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#A8BCCF"/>
        <Setter Property="Padding" Value="12,3,12,3"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                CornerRadius="2,2,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,1,1,0"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#4A6582"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C3745" Offset="0"/>
                                        <GradientStop Color="#222A35" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#E2ECF8"/>
                            <Setter Property="Margin" Value="0,0,1,0"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#3E4A5B"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#364251" Offset="0"/>
                                        <GradientStop Color="#28313D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Margin" Value="0,0,1,-1"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enterprise Main TabItem (Device List, Alarms, Workspace, etc.) -->
    <Style x:Key="ClassicEnterpriseTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#A0B4C8"/>
        <Setter Property="Padding" Value="12,2,12,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                CornerRadius="2,2,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#364353"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,1"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#242B34" Offset="0.0"/>
                                        <GradientStop Color="#1A2027" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Margin" Value="0,1,-1,0"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C3746" Offset="0.0"/>
                                        <GradientStop Color="#202732" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#E2ECF8"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3E4A5B"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="Background" Value="#212730"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Height" Value="23"/>
                            <Setter Property="Margin" Value="0,0,-1,-1"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Property Sheet TabItem -->
    <Style x:Key="ClassicPropertySheetTabItem" TargetType="TabItem" BasedOn="{StaticResource ClassicEnterpriseTabItem}"/>

    <!-- Property Sheet TabControl -->
    <Style x:Key="ClassicPropertySheetTabControl" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="#212730"/>
        <Setter Property="BorderBrush" Value="#3E4A5B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    IsItemsHost="True"
                                    Margin="0,0,0,-1"
                                    Panel.ZIndex="5"
                                    SnapsToDevicePixels="True"/>
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicTabControl" TargetType="TabControl" BasedOn="{StaticResource ClassicPropertySheetTabControl}"/>
    <Style x:Key="ClassicTabItem" TargetType="TabItem" BasedOn="{StaticResource ClassicEnterpriseTabItem}"/>

    <!-- ================================================================= -->
    <!-- 8. DARK AERO SCROLLBAR SYSTEM (8px Thin Track & Steel Thumb)      -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}"
                               Height="{TemplateBinding Height}"
                               Width="{TemplateBinding Width}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder"
                            BorderBrush="#455468"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#2F3946"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#3B495A"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#2A85D6"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#1D5B94"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#2A333E"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#1F252E"/>
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicScrollBar" TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="9"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ClassicScrollBarThumb}" Margin="1,2,1,2"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ClassicScrollBarThumb}" Margin="2,1,2,1"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ClassicScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================= -->
    <!-- 9. DARK AERO MENU & CONTEXTMENU SYSTEM                            -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicMenuSeparator" TargetType="Separator">
        <Setter Property="Height" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border BorderThickness="1,0,1,0" BorderBrush="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid Height="3" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#1D232C"
                                    BorderBrush="#2C3746"
                                    BorderThickness="0,0,1,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                            <Rectangle Grid.Column="1"
                                       Height="1"
                                       Fill="#2C3746"
                                       VerticalAlignment="Center"
                                       Margin="2,0,2,0"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ClassicTopLevelHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="itemBorder"
                BorderThickness="1"
                BorderBrush="Transparent"
                Background="Transparent"
                CornerRadius="2"
                Padding="6,2,6,2"
                Margin="1,1"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Grid>
                <ContentPresenter ContentSource="Header"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  SnapsToDevicePixels="True"/>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="False"
                       IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PopupAnimation="Fade">
                    <Border Background="#1A2027"
                            BorderBrush="#3E4E62"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,1,0,1"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#364353" Offset="0"/>
                            <GradientStop Color="#293442" Offset="0.5"/>
                            <GradientStop Color="#202934" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#3B82C4"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="itemBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#202934" Offset="0"/>
                            <GradientStop Color="#182029" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#3B82C4"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ClassicMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="TextElement.Foreground" Value="#D0DCE8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="itemBorder"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid Height="24" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="gutterBorder"
                                    Grid.Column="0"
                                    Background="#1D232C"
                                    BorderBrush="#2C3746"
                                    BorderThickness="0,0,1,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>

                            <ContentPresenter x:Name="Icon"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="8,0,16,0"
                                              SnapsToDevicePixels="True"/>

                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="#7A8EA4"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"
                                       SnapsToDevicePixels="True"/>

                            <Path x:Name="RightArrow"
                                  Grid.Column="3"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="#7A8EA4"
                                  Data="M 0,0 L 4,3.5 L 0,7 Z"
                                  Visibility="Collapsed"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="#1A2027"
                                        BorderBrush="#3E4E62"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="0,1,0,1"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    Grid.IsSharedSizeScope="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2C3848" Offset="0"/>
                                        <GradientStop Color="#202A36" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="gutterBorder" Property="Background" Value="Transparent"/>
                            <Setter TargetName="gutterBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#556677"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource ClassicTopLevelHeaderTemplate}"/>
                <Setter Property="Height" Value="22"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource ClassicTopLevelHeaderTemplate}"/>
                <Setter Property="Height" Value="22"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClassicMenu" TargetType="Menu">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#242C37" Offset="0.0"/>
                    <GradientStop Color="#1C232B" Offset="0.5"/>
                    <GradientStop Color="#171C23" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#384656"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="2,0"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicContextMenu" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#1A2027"
                            BorderBrush="#3E4E62"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="0,2,0,2"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- 10. DARK AERO EXTENDED CONTROLS                                   -->
    <!-- ================================================================= -->
    <Style x:Key="ClassicExpander" TargetType="Expander">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Setter Property="BorderBrush" Value="#384656"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ContentRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          MinHeight="26"
                                          Padding="8,4"
                                          Foreground="{DynamicResource ClassicTextTitle}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="headerBorder"
                                                BorderBrush="#384656"
                                                BorderThickness="0,0,0,1"
                                                SnapsToDevicePixels="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#28323F" Offset="0.0"/>
                                                    <GradientStop Color="#1E252F" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Margin="{TemplateBinding Padding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="0"
                                                      Data="M 1,1 L 6,5 L 1,9"
                                                      Stroke="#8CBEE8"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="8" Height="10"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1"
                                                                  ContentSource="Content"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{DynamicResource ClassicTextTitle}"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.FontSize="11"
                                                                  VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 1,2 L 5,7 L 9,2"/>
                                                <Setter TargetName="Arrow" Property="Width" Value="10"/>
                                                <Setter TargetName="Arrow" Property="Height" Value="8"/>
                                                <Setter TargetName="headerBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#2C3746" Offset="0.0"/>
                                                            <GradientStop Color="#222B37" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF"/>
                                                <Setter TargetName="headerBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#364353" Offset="0.0"/>
                                                            <GradientStop Color="#273240" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="headerBorder" Property="BorderBrush" Value="#4C86BF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Border x:Name="ExpandSite"
                                    Grid.Row="1"
                                    Padding="10"
                                    Background="#212730"
                                    Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentRow" Property="Height" Value="*"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicSearchBox" TargetType="TextBox" BasedOn="{StaticResource ClassicTextBox}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Width" Value="170"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Background" Value="#1A1F26"/>
        <Setter Property="BorderBrush" Value="#384656"/>
        <Setter Property="Padding" Value="4,1,22,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="watermark"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="#6C839C"
                                   FontStyle="Italic"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="6,0,24,0"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <Rectangle Width="13" Height="13"
                                   Fill="{DynamicResource IconSearch}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="border" Property="Background" Value="#171C23"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


