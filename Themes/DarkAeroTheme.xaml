    <SolidColorBrush x:Key="ClassicBadgeCriticalBorder" Color="#752222"/>
    <SolidColorBrush x:Key="ClassicBadgeCriticalForeground" Color="#FFA2A2"/>
    <SolidColorBrush x:Key="ClassicBadgeWarningBackground" Color="#36260B"/>
    <SolidColorBrush x:Key="ClassicBadgeWarningBorder" Color="#785312"/>
    <SolidColorBrush x:Key="ClassicBadgeWarningForeground" Color="#FFC662"/>
    <SolidColorBrush x:Key="ClassicBadgeInfoBackground" Color="#122436"/>
    <SolidColorBrush x:Key="ClassicBadgeInfoBorder" Color="#224E75"/>
    <SolidColorBrush x:Key="ClassicBadgeInfoForeground" Color="#7BBDF5"/>
    <SolidColorBrush x:Key="ClassicBadgeSuccessBackground" Color="#132E1A"/>
    <SolidColorBrush x:Key="ClassicBadgeSuccessBorder" Color="#206B36"/>
    <SolidColorBrush x:Key="ClassicBadgeSuccessForeground" Color="#7CE49B"/>

    <!-- Wizard Header Brushes -->
    <LinearGradientBrush x:Key="ClassicWizardActiveBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#253549" Offset="0.0"/>
        <GradientStop Color="#1A2838" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClassicWizardInactiveBackground" Color="#1B222C"/>
    <SolidColorBrush x:Key="ClassicWizardActiveBorder" Color="#3E5D83"/>
    <SolidColorBrush x:Key="ClassicWizardInactiveBorder" Color="#2E3846"/>
