<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Merge Vector Icons ONLY (All Dark Aero styles are natively defined) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Assets/Icons/ClassicIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- DARK AERO (OBSIDIAN AERO GLASS) COLOR PALETTE & BRUSHES           -->
    <!-- Authentic Windows 7 Dark Glass / Zune / Media Player 12 Aesthetic -->
