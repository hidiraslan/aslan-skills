                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#374354" Offset="0.0"/>
                            <GradientStop Color="#2C3746" Offset="0.45"/>
                            <GradientStop Color="#232C37" Offset="0.5"/>
                            <GradientStop Color="#1D242E" Offset="1.0"/>
