    <Style x:Key="ClassicDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#E2ECF8"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="BorderBrush" Value="#384556"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#181D24"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CalendarStyle" Value="{StaticResource ClassicCalendar}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="outerBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="1"
                            Height="22"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Style="{StaticResource ClassicDatePickerTextBox}"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="4,0,2,0"
                                               Margin="0"
                                               BorderThickness="0"
                                               Background="Transparent"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="Segoe UI"
                                               FontSize="11"/>
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Style="{StaticResource ClassicDatePickerButton}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3B82C4"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#4CA0EA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#2D3642"/>
                            <Setter TargetName="outerBorder" Property="Background" Value="#14181E"/>
                            <Setter Property="Foreground" Value="#556677"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicPaginationButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
