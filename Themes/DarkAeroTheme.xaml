    <Style x:Key="ClassicToggleSwitch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#D0DCE8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border x:Name="track"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True"
                                    BorderBrush="#3E4A5B">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#181D23" Offset="0.0"/>
                                        <GradientStop Color="#222832" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="thumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    BorderThickness="1"
                                    BorderBrush="#4C5C6E"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#424F5E" Offset="0.0"/>
                                        <GradientStop Color="#2C3540" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#2A73BA"/>
                            <Setter TargetName="track" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1D5B94" Offset="0.0"/>
                                        <GradientStop Color="#14436E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="thumb" Property="BorderBrush" Value="#3B82C4"/>
                            <Setter TargetName="thumb" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E2ECF8" Offset="0.0"/>
                                        <GradientStop Color="#BFD6ED" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumb" Property="BorderBrush" Value="#3B82C4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicDismissButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
