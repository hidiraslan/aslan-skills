    <!-- Target vs. Actual Delivery (Bullet Chart) Brushes (Dark Aero) -->
    <SolidColorBrush x:Key="ClassicBulletRange1" Color="#161E28"/>
    <SolidColorBrush x:Key="ClassicBulletRange2" Color="#222C38"/>
    <SolidColorBrush x:Key="ClassicBulletRange3" Color="#2E3C4D"/>
    <SolidColorBrush x:Key="ClassicBulletBorder" Color="#3E526B"/>
    <SolidColorBrush x:Key="ClassicBulletBarPrimary" Color="#3399FF"/>
    <SolidColorBrush x:Key="ClassicBulletBarSuccess" Color="#38C64E"/>
    <SolidColorBrush x:Key="ClassicBulletMarkerWarning" Color="#FF5252"/>
