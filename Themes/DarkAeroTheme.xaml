    <!-- Horizontal Aero Slider Thumb (Dark Aero) -->
    <Style x:Key="ClassicSliderThumbHorizontal" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder"
                            Width="11" Height="20"
                            BorderThickness="1"
                            CornerRadius="2"
                            BorderBrush="#48586B"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#425060" Offset="0.0"/>
                                <GradientStop Color="#2C3642" Offset="0.5"/>
                                <GradientStop Color="#202730" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border BorderThickness="1" CornerRadius="1" BorderBrush="#25FFFFFF" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#4CA0EA"/>
                            <Setter TargetName="thumbBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#526578" Offset="0.0"/>
                                        <GradientStop Color="#364556" Offset="0.5"/>
                                        <GradientStop Color="#253240" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#2582D6"/>
                            <Setter TargetName="thumbBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#255580" Offset="0.0"/>
                                        <GradientStop Color="#1A4064" Offset="0.5"/>
                                        <GradientStop Color="#122E4A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#333D4A"/>
                            <Setter TargetName="thumbBorder" Property="Background" Value="#1C222A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

