    <SolidColorBrush x:Key="ClassicCanvasBackground" Color="#181C22"/>
    <SolidColorBrush x:Key="ClassicCardBackground" Color="#212730"/>
    <SolidColorBrush x:Key="ClassicInnerBackground" Color="#1A1F26"/>
    <SolidColorBrush x:Key="ClassicRibbonBackground" Color="#1E252E"/>
    <SolidColorBrush x:Key="ClassicSubHeaderBackground" Color="#262E39"/>
    <SolidColorBrush x:Key="ClassicDividerBrush" Color="#3A4758"/>
    <SolidColorBrush x:Key="ClassicBorderBrush" Color="#3E4A5B"/>
    <SolidColorBrush x:Key="ClassicControlBorderBrush" Color="#3E4A5B"/>
    <SolidColorBrush x:Key="ClassicTextPrimary" Color="#E2ECF8"/>
    <SolidColorBrush x:Key="ClassicTextTitle" Color="#E2ECF8"/>
    <SolidColorBrush x:Key="ClassicTextBody" Color="#D0DCE8"/>
    <SolidColorBrush x:Key="ClassicTextSubtitle" Color="#8E9EAF"/>
    <SolidColorBrush x:Key="ClassicTextDark" Color="#D0DCE8"/>
    <SolidColorBrush x:Key="ClassicTextMuted" Color="#7B8C9F"/>
    <SolidColorBrush x:Key="ClassicSelectionBlue" Color="#186BB5"/>
