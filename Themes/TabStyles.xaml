<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- 1. RIBBON TAB STRIP & TAB ITEM (Common, Advanced)             -->
    <!-- ============================================================= -->

    <!-- Pure Ribbon TabStrip Control (uses StackPanel to eliminate clipping & stray lines) -->
    <Style x:Key="ClassicRibbonTabStrip" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <StackPanel Orientation="Horizontal"
                                IsItemsHost="True"
                                VerticalAlignment="Bottom"
                                SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic Ribbon TabItem Style -->
    <Style x:Key="ClassicRibbonTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Padding" Value="12,3,12,3"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                CornerRadius="2,2,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Unselected state: NO border at all, transparent background, text only -->
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0,1,1,0"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <!-- Hover on unselected tab -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#86A4C6"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E6F0FA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="0,0,1,0"/>
                        </MultiTrigger>
                        <!-- Selected state: Solid Left, Top, Right border, white body merging down into ribbon -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#708FA8"/>
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Margin" Value="0,0,1,-1"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============================================================= -->
    <!-- 2. PROPERTY SHEET TAB CONTROL & TAB ITEM (Device Settings)    -->
    <!-- ============================================================= -->

    <!-- TabItem for Property Sheets (Tabs connect cleanly with -1 overlap, no stray lines) -->
    <Style x:Key="ClassicPropertySheetTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Padding" Value="12,3,12,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                CornerRadius="2,2,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Unselected Tab: Sits on the line with distinct outline and subtle gradient -->
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,1"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#8FA8C8"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F6FAFE" Offset="0.0"/>
                                        <GradientStop Color="#DDE7F2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Margin" Value="0,2,-1,0"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <!-- Hover on Unselected Tab -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderBrush" Value="#5588BD"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#EAF3FD" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- Selected Tab: Stands 2px taller, white background, bottom open into container -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#708FA8"/>
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Margin" Value="0,0,-1,-1"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Complete PropertySheet TabControl Style with integrated content border -->
    <Style x:Key="ClassicPropertySheetTabControl" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#708FA8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Strip Row: sits directly on top of the content border -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    IsItemsHost="True"
                                    Margin="0,0,0,-1"
                                    Panel.ZIndex="5"
                                    SnapsToDevicePixels="True"/>

                        <!-- Content Border: 1px border all around, seamless under active tab -->
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============================================================= -->
    <!-- 3. DEVICE LIST TAB ITEM (Device List, Alarms)                 -->
    <!-- ============================================================= -->

    <Style x:Key="ClassicEnterpriseTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#1E395B"/>
        <Setter Property="Padding" Value="12,2,12,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="border"
                                CornerRadius="2,2,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Unselected tab -->
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#8FA8C8"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,1"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F6FAFE" Offset="0.0"/>
                                        <GradientStop Color="#DDE7F2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Margin" Value="0,1,-1,0"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                        <!-- MouseOver on unselected tab -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="BorderBrush" Value="#5588BD"/>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#E8F2FC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!-- Selected tab -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#708FA8"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Height" Value="23"/>
                            <Setter Property="Margin" Value="0,0,-1,-1"/>
                            <Setter Property="Panel.ZIndex" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic Pure TabStrip Control for DeviceGrid -->
    <Style x:Key="ClassicTabStripControl" TargetType="TabControl">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <StackPanel Orientation="Horizontal"
                                IsItemsHost="True"
                                VerticalAlignment="Bottom"
                                SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard Classic TabControl & TabItem Aliases -->
    <Style x:Key="ClassicTabControl" TargetType="TabControl" BasedOn="{StaticResource ClassicPropertySheetTabControl}"/>
    <Style x:Key="ClassicTabItem" TargetType="TabItem" BasedOn="{StaticResource ClassicPropertySheetTabItem}"/>

</ResourceDictionary>
